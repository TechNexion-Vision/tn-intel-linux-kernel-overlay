Index: linux-kernel-v6.17/drivers/media/i2c/max9x/max96717.c
===================================================================
--- linux-kernel-v6.17.orig/drivers/media/i2c/max9x/max96717.c
+++ linux-kernel-v6.17/drivers/media/i2c/max9x/max96717.c
@@ -67,7 +67,53 @@ static struct max9x_serial_link_ops max9
 	.disable = max96717_disable_serial_link,
 };
 
-static struct max9x_translation_ops max96717_translation_ops;
+static int max96717_add_translate_addr(struct max9x_common *common,
+				      unsigned int i2c_id, unsigned int virt_addr,
+				      unsigned int phys_addr)
+{
+	struct regmap *map = common->map;
+	unsigned int alias;
+	unsigned int src;
+	int ret;
+
+	for (alias = 0; alias < MAX96717_NUM_ALIASES; alias++) {
+		TRY(ret, regmap_read(map, MAX96717_I2C_SRC(i2c_id, alias), &src));
+		src = FIELD_GET(MAX96717_I2C_SRC_FIELD, src);
+		if (src == virt_addr || src == 0) {
+			TRY(ret, regmap_write(map, MAX96717_I2C_DST(i2c_id, alias),
+					      MAX9X_FIELD_PREP(MAX96717_I2C_DST_FIELD,
+							      phys_addr)));
+			TRY(ret, regmap_write(map, MAX96717_I2C_SRC(i2c_id, alias),
+					      MAX9X_FIELD_PREP(MAX96717_I2C_SRC_FIELD,
+							      virt_addr)));
+		}
+	}
+	return 0;
+}
+
+static int max96717_remove_translate_addr(struct max9x_common *common,
+					  unsigned int i2c_id, unsigned int virt_addr,
+					  unsigned int phys_addr)
+{
+	struct regmap *map = common->map;
+	unsigned int alias;
+	unsigned int src;
+	int ret;
+
+	for (alias = 0; alias < MAX96717_NUM_ALIASES; alias++) {
+		TRY(ret, regmap_read(map, MAX96717_I2C_SRC(i2c_id, alias), &src));
+		src = FIELD_GET(MAX96717_I2C_SRC_FIELD, src);
+		if (src == virt_addr)
+			return regmap_write(map, MAX96717_I2C_DST(i2c_id, alias),
+					    MAX9X_FIELD_PREP(MAX96717_I2C_DST_FIELD, 0));
+	}
+	return 0;
+}
+
+static struct max9x_translation_ops max96717_translation_ops = {
+	.add    = max96717_add_translate_addr,
+	.remove = max96717_remove_translate_addr,
+};
 
 static struct max9x_common *from_gpio_chip(struct gpio_chip *chip)
 {
@@ -324,6 +370,8 @@ static int max96717_max_elements(struct
 		return MAX96717_NUM_MIPI_MAPS;
 	case MAX9X_CSI_LINK:
 		return MAX96717_NUM_CSI_LINKS;
+	case MAX9X_DATA_TYPES:
+		return MAX96717_NUM_DATA_TYPES;
 	default:
 		break;
 	}
@@ -420,6 +468,9 @@ static int max96717_enable_frame_sync(st
 	int ret;
 	int deserializer_tx_id;
 
+	if (!node)
+		return 0;
+
 	ret = of_property_read_u32(node, "fsync-tx-id", &deserializer_tx_id);
 	// Not necessarily problematic, no frame sync tx found
 	if (ret == -ENODATA || ret == -EINVAL) {
@@ -450,6 +501,9 @@ static int max96717_get_datatype(struct
 	struct regmap *map = common->map;
 	int ret, datatype;
 
+	if (!node)
+		return regmap_write(map, MAX96717_FRONTTOP_16, 0);
+
 	ret = of_property_read_u32(node, "data-type", &datatype);
 	if (ret == -ENODATA || ret == -EINVAL) {
 		dev_dbg(dev, "Data-type not found not filtering");
Index: linux-kernel-v6.17/drivers/media/i2c/max9x/max96717.h
===================================================================
--- linux-kernel-v6.17.orig/drivers/media/i2c/max9x/max96717.h
+++ linux-kernel-v6.17/drivers/media/i2c/max9x/max96717.h
@@ -38,10 +38,18 @@ enum max96717_gpio_pull_updn_sel {
 };
 
 #define MAX96717_NUM_SERIAL_LINKS 1
-#define MAX96717_NUM_VIDEO_PIPES 1
+#define MAX96717_NUM_VIDEO_PIPES 4
 #define MAX96717_NUM_MIPI_MAPS 1
-#define MAX96717_NUM_CSI_LINKS 1
+#define MAX96717_NUM_CSI_LINKS 2
 #define MAX96717_NUM_GPIO 11
+#define MAX96717_NUM_DATA_TYPES 4
+
+// I2C address translation alias registers
+#define MAX96717_NUM_ALIASES 2
+#define MAX96717_I2C_SRC(i2c_id, n) ((i2c_id == 0 ? 0x42 : (0x550 + (4 * ((i2c_id) - 1)))) + (2 * (n)) + 0)
+#define MAX96717_I2C_SRC_FIELD GENMASK(7, 1)
+#define MAX96717_I2C_DST(i2c_id, n) ((i2c_id == 0 ? 0x42 : (0x550 + (4 * ((i2c_id) - 1)))) + (2 * (n)) + 1)
+#define MAX96717_I2C_DST_FIELD GENMASK(7, 1)
 
 #define MAX96717_GPIO(gpio) (0x2BE + ((gpio) * 3))
 #define MAX96717_GPIO_A(gpio) (MAX96717_GPIO(gpio) + 0)
Index: linux-kernel-v6.17/drivers/media/i2c/max9x/serdes.c
===================================================================
--- linux-kernel-v6.17.orig/drivers/media/i2c/max9x/serdes.c
+++ linux-kernel-v6.17/drivers/media/i2c/max9x/serdes.c
@@ -114,7 +114,7 @@ static struct max9x_desc max9x_chips[] =
 	},
 	/*need to check dev_id and others when used*/
 	[MAX96717] = {
-		.dev_id = 0x91,
+		.dev_id = 0xbf,
 		.rev_reg = 0xE,
 		.serdes_type = MAX9X_SERIALIZER,
 		.chip_type = MAX96717,
@@ -1729,11 +1729,17 @@ static int max9x_init_state(struct v4l2_
 			.flags = V4L2_SUBDEV_ROUTE_FL_ACTIVE,
 		},
 	};
+	/*
+	 * source_pad is the first SOURCE pad, which follows all SINK (CSI input)
+	 * pads. The index equals num_csi_links, which varies per serializer chip
+	 * (e.g. MAX9295A=2, MAX96717=1). Using num_csi_links avoids hardcoding a
+	 * value that breaks when the chip's CSI pad count differs.
+	 */
 	struct v4l2_subdev_route ser_routes[] = {
 		{
 			.sink_pad = 0,
 			.sink_stream = 0,
-			.source_pad = 2,
+			.source_pad = common->num_csi_links,
 			.source_stream = 0,
 			.flags = V4L2_SUBDEV_ROUTE_FL_ACTIVE,
 		},
Index: linux-kernel-v6.17/drivers/media/i2c/tevs/Makefile
===================================================================
--- linux-kernel-v6.17.orig/drivers/media/i2c/tevs/Makefile
+++ linux-kernel-v6.17/drivers/media/i2c/tevs/Makefile
@@ -1,4 +1,6 @@
 # SPDX-License-Identifier: GPL-2.0-only
 tevs-objs := tevs_main.o
+vlsgm2-objs := vlsgm2_main.o
 
 obj-$(CONFIG_VIDEO_TEVS) += tevs.o
+obj-$(CONFIG_VIDEO_TEVS) += vlsgm2.o
\ No newline at end of file
