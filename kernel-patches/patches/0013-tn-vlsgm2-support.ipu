+#define TEVS_AE_MANUAL_GAIN_MAX 				HOST_COMMAND_ISP_CTRL_EXP_GAIN_MAX
+#define TEVS_AE_MANUAL_GAIN_MIN 				HOST_COMMAND_ISP_CTRL_EXP_GAIN_MIN
+#define TEVS_AE_MANUAL_GAIN_MASK 				(0x00FF)
+#define TEVS_ORIENTATION 						HOST_COMMAND_ISP_CTRL_FLIP
+#define TEVS_ORIENTATION_HFLIP_BIT 				(0U)
+#define TEVS_ORIENTATION_HFLIP 					BIT(TEVS_ORIENTATION_HFLIP_BIT)
+#define TEVS_ORIENTATION_VFLIP_BIT 				(1U)
+#define TEVS_ORIENTATION_VFLIP 					BIT(TEVS_ORIENTATION_VFLIP_BIT)
+#define TEVS_FLICK_CTRL    						HOST_COMMAND_ISP_CTRL_FLICK_CTRL
+#define TEVS_FLICK_CTRL_MASK					(0xFFFF) // TEVS_REG_16BIT(0x5440)
+#define TEVS_FLICK_CTRL_FREQ(n)					((n) << 8)
+#define TEVS_FLICK_CTRL_ETC_IHDR_UP				BIT(6)
+#define TEVS_FLICK_CTRL_ETC_DIS					BIT(5)
+#define TEVS_FLICK_CTRL_FRC_OVERRIDE_MAX_ET		BIT(4)
+#define TEVS_FLICK_CTRL_FRC_OVERRIDE_UPPER_ET	BIT(3)
+#define TEVS_FLICK_CTRL_FRC_EN					BIT(2)
+#define TEVS_FLICK_CTRL_MODE_MASK				(3U << 0)
+#define TEVS_FLICK_CTRL_MODE_DISABLED			(0U << 0)
+#define TEVS_FLICK_CTRL_MODE_MANUAL				(1U << 0)
+#define TEVS_FLICK_CTRL_MODE_AUTO				(2U << 0)
+#define TEVS_FLICK_CTRL_FREQ_MASK			    (0xFF00)
+#define TEVS_FLICK_CTRL_MODE_50HZ				(TEVS_FLICK_CTRL_FREQ(50) | TEVS_FLICK_CTRL_MODE_MANUAL)
+#define TEVS_FLICK_CTRL_MODE_60HZ				(TEVS_FLICK_CTRL_FREQ(60) | TEVS_FLICK_CTRL_MODE_MANUAL)
+#define TEVS_AWB_MANUAL_TEMP 					HOST_COMMAND_ISP_CTRL_AWB_TEMP
+#define TEVS_AWB_MANUAL_TEMP_MAX 				HOST_COMMAND_ISP_CTRL_AWB_TEMP_MAX
+#define TEVS_AWB_MANUAL_TEMP_MIN 				HOST_COMMAND_ISP_CTRL_AWB_TEMP_MIN
+#define TEVS_AWB_MANUAL_TEMP_MASK 				(0xFFFF)
+#define TEVS_SHARPEN 							HOST_COMMAND_ISP_CTRL_SHARPEN
+#define TEVS_SHARPEN_MAX 						HOST_COMMAND_ISP_CTRL_SHARPEN_MAX
+#define TEVS_SHARPEN_MIN 						HOST_COMMAND_ISP_CTRL_SHARPEN_MIN
+#define TEVS_SHARPEN_MASK 						(0xFFFF)
+#define TEVS_BACKLIGHT_COMPENSATION 			HOST_COMMAND_ISP_CTRL_BACKLIGHT_COMPENSATION
+#define TEVS_BACKLIGHT_COMPENSATION_MAX 		HOST_COMMAND_ISP_CTRL_BACKLIGHT_COMPENSATION_MAX
+#define TEVS_BACKLIGHT_COMPENSATION_MIN 		HOST_COMMAND_ISP_CTRL_BACKLIGHT_COMPENSATION_MIN
+#define TEVS_BACKLIGHT_COMPENSATION_MASK 		(0xFFFF)
+#define TEVS_DZ_TGT_FCT 						HOST_COMMAND_ISP_CTRL_ZOOM_TIMES
+#define TEVS_DZ_TGT_FCT_MAX 					HOST_COMMAND_ISP_CTRL_ZOOM_TIMES_MAX
+#define TEVS_DZ_TGT_FCT_MIN 					HOST_COMMAND_ISP_CTRL_ZOOM_TIMES_MIN
+#define TEVS_DZ_TGT_FCT_MASK 					(0xFFFF)
+#define TEVS_SFX_MODE 							HOST_COMMAND_ISP_CTRL_EFFECT
+#define TEVS_SFX_MODE_SFX_MASK 					(0x00FF)
+#define TEVS_SFX_MODE_SFX_NORMAL 				(0U << 0)
+#define TEVS_SFX_MODE_SFX_BW 					(3U << 0)
+#define TEVS_SFX_MODE_SFX_GRAYSCALE 			(6U << 0)
+#define TEVS_SFX_MODE_SFX_NEGATIVE 				(7U << 0)
+#define TEVS_SFX_MODE_SFX_SKETCH 				(15U << 0)
+#define TEVS_SFX_MODE_SFX_NORMAL_IDX 			(0U << 0)
+#define TEVS_SFX_MODE_SFX_BW_IDX 				(1U << 0)
+#define TEVS_SFX_MODE_SFX_GRAYSCALE_IDX 		(2U << 0)
+#define TEVS_SFX_MODE_SFX_NEGATIVE_IDX 			(3U << 0)
+#define TEVS_SFX_MODE_SFX_SKETCH_IDX 			(4U << 0)
+#define TEVS_AE_CTRL_MODE 						HOST_COMMAND_ISP_CTRL_AE_MODE
+#define TEVS_AE_CTRL_MODE_MASK 					(0x00FF)
+#define TEVS_AE_CTRL_MANUAL_EXP_TIME_GAIN 		(0U << 0)
+#define TEVS_AE_CTRL_AUTO_GAIN 					(9U << 0)
+#define TEVS_AE_CTRL_FULL_AUTO 					(12U << 0)
+#define TEVS_AE_CTRL_MANUAL_EXP_TIME_GAIN_IDX 	(0U << 0)
+#define TEVS_AE_CTRL_FULL_AUTO_IDX 				(1U << 0)
+#define TEVS_AE_CTRL_AUTO_GAIN_IDX				(2U << 0)
+#define TEVS_DZ_CT_X 							HOST_COMMAND_ISP_CTRL_CT_X
+#define TEVS_DZ_CT_Y 							HOST_COMMAND_ISP_CTRL_CT_Y
+#define TEVS_DZ_CT_MASK 						(0xFFFF)
+#define TEVS_DZ_CT_MAX 							HOST_COMMAND_ISP_CTRL_CT_MAX
+#define TEVS_DZ_CT_MIN 							HOST_COMMAND_ISP_CTRL_CT_MIN
+#define TEVS_BSL_MODE_NORMAL_IDX				(0U << 0)
+#define TEVS_BSL_MODE_FLASH_IDX 				(1U << 0)
+#define TEVS_MAX_FPS							HOST_COMMAND_ISP_CTRL_PREVIEW_MAX_FPS
+#define TEVS_MAX_FPS_MASK 						(0x00FF)
+#define TEVS_DENOISE							HOST_COMMAND_ISP_CTRL_DENOISE
+#define TEVS_DENOISE_MAX 						HOST_COMMAND_ISP_CTRL_DENOISE_MAX
+#define TEVS_DENOISE_MIN 						HOST_COMMAND_ISP_CTRL_DENOISE_MIN
+#define TEVS_DENOISE_MASK 						(0xFFFF)
+#define TEVS_TRIGGER_MODE						HOST_COMMAND_ISP_CTRL_TRIGGER_MODE
+#define TEVS_TRIGGER_MODE_MASK		 			(0x0003)
+#define TEVS_TRIGGER_MODE_DISABLE				(0U << 0)
+#define TEVS_TRIGGER_MODE_SYNC					(1U << 0)
+#define TEVS_TRIGGER_MODE_PERIODIC				(2U << 0)
+#define TEVS_TRIGGER_MODE_NON_PERIODIC			(3U << 0)
+#define TEVS_TRIGGER_MODE_DISABLE_IDX			(0U << 0)
+#define TEVS_TRIGGER_MODE_SYNC_IDX				(1U << 0)
+#define TEVS_TRIGGER_MODE_PERIODIC_IDX			(2U << 0)
+#define TEVS_TRIGGER_MODE_NON_PERIODIC_IDX		(3U << 0)
+
+#define V4L2_CID_USER_TEVS_BASE				(V4L2_CID_USER_BASE + 0x2000)
+#define V4L2_CID_TEVS_BSL_MODE				(V4L2_CID_USER_TEVS_BASE + 0)
+#define V4L2_CID_TEVS_MAX_FPS				(V4L2_CID_USER_TEVS_BASE + 1)
+#define V4L2_CID_TEVS_DENOISE				(V4L2_CID_USER_TEVS_BASE + 2)
+#define V4L2_CID_TEVS_AE_EXP_TIME_UPPER		(V4L2_CID_USER_TEVS_BASE + 3)
+#define V4L2_CID_TEVS_AE_EXP_TIME_MAX		(V4L2_CID_USER_TEVS_BASE + 4)
+#define V4L2_CID_TEVS_TRIGGER_MODE			(V4L2_CID_USER_TEVS_BASE + 5)
+
+#define DEFAULT_HEADER_VERSION 3
+#define TEVS_BOOT_TIME						(250)
+#define TOTAL_MICROSEC_PERSEC               (1000000)
+
+#define TEVS_IMG_FORMAT_UYVY				(0x50)
+
+#define TEVS_LINK_FREQUENCY_DEFAULT			400000000ull
+#define TEVS_PIXEL_RATE_DEFAULT				200000000ull
+
+#define TEVS_CONTINUOUS_CLOCK_DEFAULT 		(0)
+
+int vlsgm2_data_freq = 800;
+module_param(vlsgm2_data_freq, int, S_IRUSR | S_IWUSR | S_IRGRP | S_IROTH);
+MODULE_PARM_DESC(vlsgm2_data_freq, "VLS-GM2 Data Frequency");
+int vlsgm2_continuous_clk = 1;
+module_param(vlsgm2_continuous_clk, int, S_IRUSR | S_IWUSR | S_IRGRP | S_IROTH);
+MODULE_PARM_DESC(vlsgm2_continuous_clk, "VLS-GM2 MIPI Continuous Clock");
+
+struct header_info {
+	u8 header_version;
+	u16 content_offset;
+	u16 sensor_type;
+	u8 sensor_fuseid[16];
+	u8 product_name[64];
+	u8 lens_id[16];
+	u16 fix_checksum;
+	u8 tn_fw_version[2];
+	u16 vendor_fw_version;
+	u16 custom_number;
+	u8 build_year;
+	u8 build_month;
+	u8 build_day;
+	u8 build_hour;
+	u8 build_minute;
+	u8 build_second;
+	u16 mipi_datarate;
+	u32 content_len;
+	u16 content_checksum;
+	u16 total_checksum;
+} __attribute__((packed));
+
+struct vlsgm2 {
+	struct device *dev;
+	struct i2c_client *client;
+	struct v4l2_subdev v4l2_subdev;
+	struct media_pad pad;
+	struct v4l2_mbus_framefmt fmt;
+	struct regmap *regmap;
+	struct header_info *header_info;
+	struct gpio_desc *reset_gpio;
+	struct gpio_desc *standby_gpio;
+
+	int data_lanes;
+	int continuous_clock;
+	int data_frequency;
+	u8 selected_mode;
+	u8 selected_sensor;
+	bool hw_reset_mode;
+	int trigger_mode;
+	char *sensor_name;
+	int vc_id;
+
+	struct mutex lock; /* Protects formats */
+	/* V4L2 Controls */
+	struct v4l2_ctrl_handler ctrls;
+	struct v4l2_ctrl *brightness;
+	struct v4l2_ctrl *contrast;
+	struct v4l2_ctrl *saturation;
+	struct v4l2_ctrl *awb;
+	struct v4l2_ctrl *gamma;
+	struct v4l2_ctrl *exp_time;
+	struct v4l2_ctrl *exp_gain;
+	struct v4l2_ctrl *hflip;
+	struct v4l2_ctrl *vflip;
+	struct v4l2_ctrl *flick;
+	struct v4l2_ctrl *wb_temp;
+	struct v4l2_ctrl *sharpness;
+	struct v4l2_ctrl *backlight_comp;
+	struct v4l2_ctrl *colorfx;
+	struct v4l2_ctrl *ae;
+	struct v4l2_ctrl *pan;
+	struct v4l2_ctrl *tilt;
+	struct v4l2_ctrl *zoom;
+	struct v4l2_ctrl *link_freq;
+	struct v4l2_ctrl *pixel_rate;
+	struct v4l2_ctrl *bsl;
+	struct v4l2_ctrl *max_fps;
+	struct v4l2_ctrl *denoise;
+	struct v4l2_ctrl *ae_exp_upper;
+	struct v4l2_ctrl *ae_exp_max;
+	struct v4l2_ctrl *trigger;
+
+	struct tevs_platform_data *platform_data;
+};
+
+static const struct regmap_config vlsgm2_regmap_config = {
+	.reg_bits = 16,
+	.val_bits = 8,
+	.cache_type = REGCACHE_NONE,
+};
+
+static int vlsgm2_pca953x_i2c_wr8(struct vlsgm2 *vlsgm2, u8 reg, u8 val)
+{
+	// struct device *dev = vlsgm2->dev;
+	struct i2c_client *client = to_i2c_client(vlsgm2->dev);
+	int ret;
+	struct i2c_msg msg;
+	u8 pca953x_addr = 0x25;
+	u8 data[2];
+
+	msg.addr = pca953x_addr;
+	msg.buf = data;
+	msg.len = 2;
+	msg.flags = 0;
+
+	data[0] = reg;
+	data[1] = val;
+
+	ret = i2c_transfer(client->adapter, &msg, 1);
+
+	if (ret != 1) {
+		dev_err(&client->dev, "%s: write register 0x%x from 0x%x failed\n",
+			__func__, reg, pca953x_addr);
+	}
+	dev_dbg(&client->dev, "i2c: write register: 0x%04X = 0x%02X\n",
+		reg, val);
+
+	return ret;
+}
+
+static int vlsgm2_rpi22_trick_init(struct vlsgm2 *vlsgm2)
+{
+	struct device *dev = vlsgm2->dev;
+	int ret = 0;
+
+	dev_dbg(dev, "%s(): pca953 initial...\n", __func__);
+
+	ret += vlsgm2_pca953x_i2c_wr8(vlsgm2, 0x01, 0xeb);
+	// ret += vlsgm2_pca953x_i2c_wr8(vlsgm2, 0x02, 0x00);
+	ret += vlsgm2_pca953x_i2c_wr8(vlsgm2, 0x03, 0xeb);
+
+	if (ret < 2) {
+		dev_err(dev, "%s(): pca953 initial fail\n", __func__);
+		return -EINVAL;
+	}
+
+	return 0;
+}
+
+static int vlsgm2_pca953x_reset(struct vlsgm2 *vlsgm2, u8 reset)
+{
+	struct device *dev = vlsgm2->dev;
+	u8 val = 0xeb;
+	int ret = 0;
+
+	dev_dbg(dev, "%s(): %d\n", __func__, reset);
+
+	// Check the value to set bit 4
+    if (reset == 0) {
+		val &= ~(1 << 4); // Clear bit 4 to 0
+    } else {
+        val |= (1 << 4); // Set bit 4 to 1
+    }
+	dev_dbg(dev, "%s(): reset val=0x%02x\n", __func__, val);
+	ret = vlsgm2_pca953x_i2c_wr8(vlsgm2, 0x01, val);
+	if (ret < 1) {
+		dev_err(dev, "%s(): set standby pin fail\n", __func__);
+		return -ret;
+	}
+
+	return 0;
+}
+
+static int vlsgm2_pca953x_standby(struct vlsgm2 *vlsgm2, u8 standby)
+{
+	struct device *dev = vlsgm2->dev;
+	u8 val = 0xeb;
+	int ret = 0;
+
+	dev_dbg(dev, "%s(): %d\n", __func__, standby);
+
+	// Check the value to set bit 2
+    if (standby == 0) {
+		val &= ~(1 << 2); // Clear bit 2 to 0
+    } else {
+        val |= (1 << 2); // Set bit 2 to 1
+    }
+	dev_dbg(dev, "%s(): standby val=0x%02x\n", __func__, val);
+	ret = vlsgm2_pca953x_i2c_wr8(vlsgm2, 0x01, val);
+	if (ret < 1) {
+		dev_err(dev, "%s(): set standby pin fail\n", __func__);
+		return -ret;
+	}
+
+	return 0;
+}
+
+static int vlsgm2_i2c_read(struct vlsgm2 *vlsgm2, u16 reg, u8 *val, u16 size)
+{
+	int ret;
+
+	ret = regmap_bulk_read(vlsgm2->regmap, reg, val, size);
+	if (ret < 0) {
+		dev_err(vlsgm2->dev,
+			"Failed to read from register: ret=%d, reg=0x%x\n", ret,
+			reg);
+		return ret;
+	}
+
+	return 0;
+}
+
+static int vlsgm2_i2c_read_16b(struct vlsgm2 *vlsgm2, u16 reg, u16 *value)
+{
+	u8 v[2] = { 0 };
+	int ret;
+
+	ret = vlsgm2_i2c_read(vlsgm2, reg, v, 2);
+	if (ret < 0) {
+		dev_err(vlsgm2->dev,
+			"Failed to read from register: ret=%d, reg=0x%x\n", ret,
+			reg);
+		return ret;
+	}
+
+	*value = (v[0] << 8) | v[1];
+	dev_dbg(vlsgm2->dev, "%s() read reg 0x%x, value 0x%x\n", __func__, reg,
+		*value);
+
+	return 0;
+}
+
+static int vlsgm2_i2c_write(struct vlsgm2 *vlsgm2, u16 reg, u8 *val, u16 size)
+{
+	int ret;
+
+	ret = regmap_bulk_write(vlsgm2->regmap, reg, val, size);
+	if (ret < 0) {
+		dev_err(vlsgm2->dev,
+			"Failed to write to register: ret=%d reg=0x%x\n", ret,
+			reg);
+		return ret;
+	}
+
+	return 0;
+}
+
+static int vlsgm2_i2c_write_16b(struct vlsgm2 *vlsgm2, u16 reg, u16 val)
+{
+	int ret;
+	u8 data[2];
+	data[0] = val >> 8;
+	data[1] = val & 0xFF;
+
+	ret = regmap_bulk_write(vlsgm2->regmap, reg, data, 2);
+	if (ret < 0) {
+		dev_err(vlsgm2->dev,
+			"Failed to write to register: ret=%d reg=0x%x\n", ret,
+			reg);
+		return ret;
+	}
+	dev_dbg(vlsgm2->dev, "%s() write reg 0x%x, value 0x%x\n", __func__, reg,
+		val);
+
+	return 0;
+}
+
+static int vlsgm2_check_trigger_mode(struct vlsgm2 *vlsgm2)
+{
+	u16 val;
+	dev_dbg(vlsgm2->dev, "%s()\n", __func__);
+
+	vlsgm2_i2c_read_16b(vlsgm2, TEVS_TRIGGER_MODE, &val);
+	if ((val & TEVS_TRIGGER_MODE_MASK) == TEVS_TRIGGER_MODE_DISABLE)
+		return 0;
+	else
+		return 1;
+}
+
+static int vlsgm2_check_version(struct vlsgm2 *vlsgm2)
+{
+	struct device *dev = vlsgm2->dev;
+	u8 version[4] = { 0 };
+	int ret = 0;
+
+	ret = vlsgm2_i2c_read(vlsgm2, HOST_COMMAND_TEVS_INFO_VERSION_MSB,
+			    &version[0], 4);
+	if (ret < 0) {
+		dev_err(dev, "can't check version\n");
+		return ret;
+	}
+	dev_info(dev, "Version:%d.%d.%d.%d\n", version[0], version[1],
+		 version[2], version[3]);
+
+	return 0;
+}
+
+static int vlsgm2_load_header_info(struct vlsgm2 *vlsgm2)
+{
+	struct device *dev = vlsgm2->dev;
+	struct header_info *header = vlsgm2->header_info;
+	u8 header_ver;
+	int ret = 0;
+
+	ret = vlsgm2_i2c_read(vlsgm2, HOST_COMMAND_ISP_BOOTDATA_1, &header_ver, 1);
+
+	if (ret < 0) {
+		dev_err(dev, "can't recognize header info\n");
+		return ret;
+	}
+
+	if (header_ver == DEFAULT_HEADER_VERSION) {
+		vlsgm2_i2c_read(vlsgm2, HOST_COMMAND_ISP_BOOTDATA_1, (u8 *)header,
+			      sizeof(struct header_info));
+
+		dev_info(dev, "Product:%s, HeaderVer:%d, MIPI_Rate:%d\n",
+			 header->product_name, header->header_version,
+			 header->mipi_datarate);
+
+		dev_dbg(dev, "content checksum: %x, content length: %d\n",
+			header->content_checksum, header->content_len);
+
+		return 0;
+	} else {
+		dev_err(dev, "can't recognize header version number '0x%X'\n",
+			header_ver);
+		return -EINVAL;
+	}
+}
+
+static int vlsgm2_standby(struct vlsgm2 *vlsgm2, int enable)
+{
+	u16 v = 0xFFFF;
+	int timeout = 0;
+	dev_dbg(vlsgm2->dev, "%s():enable=%d\n", __func__, enable);
+
+	if (enable == 1) {
+		vlsgm2_i2c_write_16b(vlsgm2, HOST_COMMAND_ISP_CTRL_SYSTEM_START,
+				   0x0000);
+		while (timeout < 100) {
+			vlsgm2_i2c_read_16b(
+				vlsgm2, HOST_COMMAND_ISP_CTRL_SYSTEM_START, &v);
+			if ((v & 0xFF00) == 0x0000)
+				break;
+			if (++timeout >= 100) {
+				dev_err(vlsgm2->dev, "timeout: line[%d]v=%x\n",
+					__LINE__, v);
+				return -EINVAL;
+			}
+			usleep_range(9000, 10000);
+		}
+		dev_dbg(vlsgm2->dev, "sensor standby\n");
+	} else {
+		vlsgm2_i2c_write_16b(vlsgm2, HOST_COMMAND_ISP_CTRL_SYSTEM_START,
+				   0x0001);
+		while (timeout < 100) {
+			vlsgm2_i2c_read_16b(
+				vlsgm2, HOST_COMMAND_ISP_CTRL_SYSTEM_START, &v);
+			if ((v & 0xFF00) == 0x0100)
+				break;
+			if (++timeout >= 100) {
+				dev_err(vlsgm2->dev, "timeout: line[%d]v=%x\n",
+					__LINE__, v);
+				return -EINVAL;
+			}
+			usleep_range(9000, 10000);
+		}
+		dev_dbg(vlsgm2->dev, "sensor wakeup\n");
+	}
+
+	return 0;
+}
+
+static int vlsgm2_check_boot_state(struct vlsgm2 *vlsgm2)
+{
+	u16 boot_state;
+	u8 timeout = 0;
+	int ret = 0;
+
+	while (timeout < 20) {
+		vlsgm2_i2c_read_16b(vlsgm2, HOST_COMMAND_TEVS_BOOT_STATE,
+				  &boot_state);
+		if (boot_state == 0x08)
+			break;
+		dev_dbg(vlsgm2->dev, "tevs bootup state: %d\n", boot_state);
+		if (++timeout >= 20) {
+			dev_err(vlsgm2->dev,
+				"tevs bootup timeout: state: 0x%02X\n",
+				boot_state);
+			ret = -EINVAL;
+		}
+		msleep(20);
+	}
+
+	return ret;
+}
+
+static int vlsgm2_set_stream(struct v4l2_subdev *sub_dev, int enable)
+{
+	struct vlsgm2 *vlsgm2 = container_of(sub_dev, struct vlsgm2, v4l2_subdev);
+	int ret = 0;
+	u8 exp[4] = { 0 };
+	dev_dbg(sub_dev->dev, "%s() enable [%x]\n", __func__, enable);
+
+	if (vlsgm2->selected_mode >=
+	    tevs_sensor_table[vlsgm2->selected_sensor].res_list_size)
+		return -EINVAL;
+
+	if (enable == 0) {
+		if (!(vlsgm2->hw_reset_mode | vlsgm2_check_trigger_mode(vlsgm2)))
+			ret = vlsgm2_standby(vlsgm2, 1);
+
+		if (ret == 0) {
+			vlsgm2_i2c_write_16b(
+				vlsgm2, HOST_COMMAND_ISP_CTRL_PREVIEW_HINF_CTRL,
+				0x10 | (TEVS_CONTINUOUS_CLOCK_DEFAULT << 5) | (vlsgm2->data_lanes));
+		}
+	} else {
+		if (!(vlsgm2->hw_reset_mode | vlsgm2_check_trigger_mode(vlsgm2)))
+			ret = vlsgm2_standby(vlsgm2, 0);
+
+		if (ret == 0) {
+			int fps = tevs_sensor_table[vlsgm2->selected_sensor]
+					  .res_list[vlsgm2->selected_mode]
+					  .framerates;
+			dev_dbg(sub_dev->dev, "%s() width=%d, height=%d\n",
+				__func__,
+				tevs_sensor_table[vlsgm2->selected_sensor]
+					.res_list[vlsgm2->selected_mode]
+					.width,
+				tevs_sensor_table[vlsgm2->selected_sensor]
+					.res_list[vlsgm2->selected_mode]
+					.height);
+			vlsgm2_i2c_write_16b(vlsgm2,
+					   HOST_COMMAND_ISP_CTRL_PREVIEW_FORMAT,
+					   0x50);
+			vlsgm2_i2c_write_16b(
+				vlsgm2, HOST_COMMAND_ISP_CTRL_PREVIEW_HINF_CTRL,
+				0x10 | (vlsgm2->continuous_clock << 5) |
+					(vlsgm2->data_lanes));
+			vlsgm2_i2c_write_16b(
+				vlsgm2, HOST_COMMAND_ISP_CTRL_PREVIEW_MIPI_CTRL,
+				vlsgm2->vc_id);
+			vlsgm2_i2c_write_16b(
+				vlsgm2, HOST_COMMAND_ISP_CTRL_PREVIEW_SENSOR_MODE,
+				tevs_sensor_table[vlsgm2->selected_sensor]
+					.res_list[vlsgm2->selected_mode]
+					.mode);
+			vlsgm2_i2c_write_16b(
+				vlsgm2, HOST_COMMAND_ISP_CTRL_PREVIEW_WIDTH,
+				tevs_sensor_table[vlsgm2->selected_sensor]
+					.res_list[vlsgm2->selected_mode]
+					.width);
+			vlsgm2_i2c_write_16b(
+				vlsgm2, HOST_COMMAND_ISP_CTRL_PREVIEW_HEIGHT,
+				tevs_sensor_table[vlsgm2->selected_sensor]
+					.res_list[vlsgm2->selected_mode]
+					.height);
+			// vlsgm2_i2c_write_16b(
+			// 	vlsgm2, HOST_COMMAND_ISP_CTRL_EXP_TIME_MSB,
+			// 	vlsgm2->exp_time->cur.val >> 16);
+			// vlsgm2_i2c_write_16b(
+			// 	vlsgm2, HOST_COMMAND_ISP_CTRL_EXP_TIME_LSB,
+			// 	vlsgm2->exp_time->cur.val & 0xFFFF);
+			vlsgm2_i2c_write_16b(
+				vlsgm2, HOST_COMMAND_ISP_CTRL_PREVIEW_MAX_FPS,
+				fps);
+			if (vlsgm2->max_fps)
+				vlsgm2->max_fps->cur.val = fps;
+			vlsgm2_i2c_read(vlsgm2, TEVS_AE_MANUAL_EXP_TIME, exp, 4);
+			vlsgm2->exp_time->cur.val = be32_to_cpup((__be32 *)exp) &
+				  TEVS_AE_MANUAL_EXP_TIME_MASK;
+		}
+	}
+
+	return ret;
+}
+
+static int vlsgm2_enum_mbus_code(struct v4l2_subdev *sub_dev,
+			       struct v4l2_subdev_state *sd_state,
+			       struct v4l2_subdev_mbus_code_enum *code)
+{
+	if (code->pad || code->index > 0)
+		return -EINVAL;
+
+	code->code = MEDIA_BUS_FMT_UYVY8_1X16;
+
+	return 0;
+}
+
+static int vlsgm2_get_fmt(struct v4l2_subdev *sub_dev,
+			struct v4l2_subdev_state *sd_state,
+			struct v4l2_subdev_format *format)
+{
+	struct v4l2_mbus_framefmt *fmt;
+	struct v4l2_mbus_framefmt *mbus_fmt = &format->format;
+	struct vlsgm2 *vlsgm2 = container_of(sub_dev, struct vlsgm2, v4l2_subdev);
+
+	if (format->pad != 0)
+		return -EINVAL;
+
+	if (format->which == V4L2_SUBDEV_FORMAT_TRY)
+#if LINUX_VERSION_CODE < KERNEL_VERSION(6, 8, 0)
+		format->format = *v4l2_subdev_get_try_format(sub_dev, sd_state,
+							  format->pad);
+#else
+		format->format = *v4l2_subdev_state_get_format(sd_state,
+							  format->pad);
+#endif
+	else
+		fmt = &vlsgm2->fmt;
+
+	memmove(mbus_fmt, fmt, sizeof(struct v4l2_mbus_framefmt));
+
+	return 0;
+}
+
+static int vlsgm2_set_fmt(struct v4l2_subdev *sub_dev,
+			struct v4l2_subdev_state *sd_state,
+			struct v4l2_subdev_format *format)
+{
+	struct v4l2_mbus_framefmt *fmt;
+	struct v4l2_mbus_framefmt *mbus_fmt = &format->format;
+	struct vlsgm2 *vlsgm2 = container_of(sub_dev, struct vlsgm2, v4l2_subdev);
+	int i;
+
+	if (format->pad != 0)
+		return -EINVAL;
+
+	for (i = 0; i < tevs_sensor_table[vlsgm2->selected_sensor].res_list_size;
+	     i++) {
+		if (mbus_fmt->width == tevs_sensor_table[vlsgm2->selected_sensor]
+					       .res_list[i]
+					       .width &&
+		    mbus_fmt->height == tevs_sensor_table[vlsgm2->selected_sensor]
+						.res_list[i]
+						.height)
+			break;
+	}
+
+	if (i >= tevs_sensor_table[vlsgm2->selected_sensor].res_list_size) {
+		return -EINVAL;
+	}
+	vlsgm2->selected_mode = i;
+	dev_dbg(sub_dev->dev, "%s() selected mode index [%d]\n", __func__,
+		vlsgm2->selected_mode);
+
+	mbus_fmt->width =
+		tevs_sensor_table[vlsgm2->selected_sensor].res_list[i].width;
+	mbus_fmt->height =
+		tevs_sensor_table[vlsgm2->selected_sensor].res_list[i].height;
+	mbus_fmt->code = MEDIA_BUS_FMT_UYVY8_1X16;
+	mbus_fmt->colorspace = V4L2_COLORSPACE_SRGB;
+	mbus_fmt->ycbcr_enc = V4L2_MAP_YCBCR_ENC_DEFAULT(mbus_fmt->colorspace);
+	mbus_fmt->quantization = V4L2_QUANTIZATION_FULL_RANGE;
+	mbus_fmt->xfer_func = V4L2_MAP_XFER_FUNC_DEFAULT(mbus_fmt->colorspace);
+	memset(mbus_fmt->reserved, 0, sizeof(mbus_fmt->reserved));
+
+	if (format->which == V4L2_SUBDEV_FORMAT_TRY)
+#if LINUX_VERSION_CODE < KERNEL_VERSION(6, 8, 0)
+		*v4l2_subdev_get_try_format(sd, sd_state, format->pad) = format->format;
+#else
+		*v4l2_subdev_state_get_format(sd_state, format->pad) = format->format;
+#endif
+	else
+		fmt = &vlsgm2->fmt;
+
+	memmove(fmt, mbus_fmt, sizeof(struct v4l2_mbus_framefmt));
+
+	return 0;
+}
+
+static int vlsgm2_get_frame_desc(struct v4l2_subdev *sd,
+	unsigned int pad, struct v4l2_mbus_frame_desc *desc)
+{
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(6, 10, 0)
+	struct vlsgm2 *vlsgm2 = container_of(sd, struct vlsgm2, v4l2_subdev);
+#endif
+	unsigned int i;
+
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(6, 10, 0)
+	desc->type = V4L2_MBUS_FRAME_DESC_TYPE_CSI2;
+#endif
+	desc->num_entries = V4L2_FRAME_DESC_ENTRY_MAX;
+
+	for (i = 0; i < desc->num_entries; i++) {
+		desc->entry[i].flags = 0;
+		desc->entry[i].pixelcode = MEDIA_BUS_FMT_FIXED;
+		desc->entry[i].length = 0;
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(6, 10, 0)
+		desc->entry[i].stream = i;
+		desc->entry[i].bus.csi2.vc = i;
+		desc->entry[i].bus.csi2.dt =
+		vlsgm2->fmt.code == MEDIA_BUS_FMT_SGRBG8_1X8 ? MIPI_CSI2_DT_RAW8 :
+		vlsgm2->fmt.code == MEDIA_BUS_FMT_SGRBG10_1X10 ? MIPI_CSI2_DT_RAW10 :
+		vlsgm2->fmt.code == MEDIA_BUS_FMT_SGRBG12_1X12 ? MIPI_CSI2_DT_RAW12 :
+		vlsgm2->fmt.code == MEDIA_BUS_FMT_SGRBG16_1X16 ? MIPI_CSI2_DT_RAW16 :
+		MIPI_CSI2_DT_YUV422_8B;
+#endif
+	}
+
+	return 0;
+}
+
+static int vlsgm2_get_selection(struct v4l2_subdev *sub_dev,
+			      struct v4l2_subdev_state *sub_state,
+			      struct v4l2_subdev_selection *sel)
+{
+	struct vlsgm2 *vlsgm2 = container_of(sub_dev, struct vlsgm2, v4l2_subdev);
+	switch (sel->target) {
+	case V4L2_SEL_TGT_CROP:
+	case V4L2_SEL_TGT_NATIVE_SIZE:
+	case V4L2_SEL_TGT_CROP_DEFAULT:
+	case V4L2_SEL_TGT_CROP_BOUNDS:
+		sel->r.top = 0;
+		sel->r.left = 0;
+		sel->r.width = vlsgm2->fmt.width;
+		sel->r.height = vlsgm2->fmt.height;
+
+		dev_dbg(sub_dev->dev, "%s() selection [%d, %d, %d, %d]\n",
+			__func__, sel->r.top, sel->r.left, sel->r.width,
+			sel->r.height);
+		return 0;
+	}
+
+	return -EINVAL;
+}
+
+static int vlsgm2_enum_frame_size(struct v4l2_subdev *sub_dev,
+				struct v4l2_subdev_state *sd_state,
+				struct v4l2_subdev_frame_size_enum *fse)
+{
+	struct vlsgm2 *vlsgm2 = container_of(sub_dev, struct vlsgm2, v4l2_subdev);
+
+	dev_dbg(sub_dev->dev, "%s()\n", __func__);
+	if ((fse->pad != 0) ||
+	    (fse->index >=
+	     tevs_sensor_table[vlsgm2->selected_sensor].res_list_size))
+		return -EINVAL;
+
+	fse->min_width = fse->max_width =
+		tevs_sensor_table[vlsgm2->selected_sensor]
+			.res_list[fse->index]
+			.width;
+	fse->min_height = fse->max_height =
+		tevs_sensor_table[vlsgm2->selected_sensor]
+			.res_list[fse->index]
+			.height;
+
+	return 0;
+}
+
+static int vlsgm2_enum_frame_interval(struct v4l2_subdev *sub_dev,
+				    struct v4l2_subdev_state *sd_state,
+				    struct v4l2_subdev_frame_interval_enum *fie)
+{
+	struct vlsgm2 *vlsgm2 = container_of(sub_dev, struct vlsgm2, v4l2_subdev);
+	int i;
+
+	if ((fie->pad != 0) || (fie->index != 0))
+		return -EINVAL;
+
+	dev_dbg(sub_dev->dev, "%s() index [%u]\n", __func__, fie->index);
+
+	fie->interval.numerator = 1;
+
+	for (i = 0; i < tevs_sensor_table[vlsgm2->selected_sensor].res_list_size;
+	     i++) {
+		if (fie->width == tevs_sensor_table[vlsgm2->selected_sensor]
+					  .res_list[i]
+					  .width &&
+		    fie->height == tevs_sensor_table[vlsgm2->selected_sensor]
+					   .res_list[i]
+					   .height) {
+			fie->interval.denominator =
+				tevs_sensor_table[vlsgm2->selected_sensor]
+					.res_list[i]
+					.framerates;
+			break;
+		}
+	}
+
+	dev_dbg(sub_dev->dev, "%s() frame rate [%u]\n", __func__,
+		fie->interval.denominator);
+
+	return 0;
+}
+
