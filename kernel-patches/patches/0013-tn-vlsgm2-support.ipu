+
+static int vlsgm2_set_brightness(struct vlsgm2 *vlsgm2, s32 value)
+{
+	// Format is u3.12
+	return vlsgm2_i2c_write_16b(vlsgm2, TEVS_BRIGHTNESS,
+				  value & TEVS_BRIGHTNESS_MASK);
+}
+
+static int vlsgm2_set_contrast(struct vlsgm2 *vlsgm2, s32 value)
+{
+	// Format is u3.12
+	return vlsgm2_i2c_write_16b(vlsgm2, TEVS_CONTRAST,
+				  value & TEVS_CONTRAST_MASK);
+}
+
+static int vlsgm2_set_saturation(struct vlsgm2 *vlsgm2, s32 value)
+{
+	// Format is u3.12
+	return vlsgm2_i2c_write_16b(vlsgm2, TEVS_SATURATION,
+				  value & TEVS_SATURATION_MASK);
+}
+
+static int vlsgm2_set_awb_mode(struct vlsgm2 *vlsgm2, s32 mode)
+{
+	u16 val = mode & TEVS_AWB_CTRL_MODE_MASK;
+
+	switch (val) {
+	case TEVS_AWB_CTRL_MODE_MANUAL_TEMP_IDX:
+		val = TEVS_AWB_CTRL_MODE_MANUAL_TEMP;
+		break;
+	case TEVS_AWB_CTRL_MODE_AUTO_IDX:
+		val = TEVS_AWB_CTRL_MODE_AUTO;
+		break;
+	default:
+		val = TEVS_AWB_CTRL_MODE_AUTO;
+		break;
+	}
+
+	return vlsgm2_i2c_write_16b(vlsgm2, TEVS_AWB_CTRL_MODE, val);
+}
+
+static int vlsgm2_set_gamma(struct vlsgm2 *vlsgm2, s32 value)
+{
+	// Format is u3.12
+	return vlsgm2_i2c_write_16b(vlsgm2, TEVS_GAMMA, value & TEVS_GAMMA_MASK);
+}
+
+static int vlsgm2_set_exposure(struct vlsgm2 *vlsgm2, s32 value)
+{
+	u8 val[4];
+	__be32 temp;
+	int ret;
+
+	temp = cpu_to_be32(value);
+	memcpy(val, &temp, 4);
+
+	ret = vlsgm2_i2c_write(vlsgm2, TEVS_AE_MANUAL_EXP_TIME, val, 4);
+	if (ret)
+		return ret;
+
+	return 0;
+}
+
+static int vlsgm2_set_gain(struct vlsgm2 *vlsgm2, s32 value)
+{
+	return vlsgm2_i2c_write_16b(vlsgm2, TEVS_AE_MANUAL_GAIN,
+				  value & TEVS_AE_MANUAL_GAIN_MASK);
+}
+
+static int vlsgm2_set_hflip(struct vlsgm2 *vlsgm2, s32 flip)
+{
+	u16 val;
+	int ret;
+
+	ret = vlsgm2_i2c_read_16b(vlsgm2, TEVS_ORIENTATION, &val);
+	if (ret)
+		return ret;
+
+	val &= ~TEVS_ORIENTATION_HFLIP;
+	val |= flip ? TEVS_ORIENTATION_HFLIP : 0;
+
+	return vlsgm2_i2c_write_16b(vlsgm2, TEVS_ORIENTATION, val);
+}
+
+static int vlsgm2_set_vflip(struct vlsgm2 *vlsgm2, s32 flip)
+{
+	u16 val;
+	int ret;
+
+	ret = vlsgm2_i2c_read_16b(vlsgm2, TEVS_ORIENTATION, &val);
+	if (ret)
+		return ret;
+
+	val &= ~TEVS_ORIENTATION_VFLIP;
+	val |= flip ? TEVS_ORIENTATION_VFLIP : 0;
+
+	return vlsgm2_i2c_write_16b(vlsgm2, TEVS_ORIENTATION, val);
+}
+
+static int vlsgm2_set_flick_mode(struct vlsgm2 *vlsgm2, s32 mode)
+{
+	u16 val = 0;
+	switch (mode) {
+	case V4L2_CID_POWER_LINE_FREQUENCY_DISABLED:
+		val = TEVS_FLICK_CTRL_MODE_DISABLED;
+		break;
+	case V4L2_CID_POWER_LINE_FREQUENCY_50HZ:
+		val = TEVS_FLICK_CTRL_MODE_50HZ;
+		break;
+	case V4L2_CID_POWER_LINE_FREQUENCY_60HZ:
+		val = TEVS_FLICK_CTRL_MODE_60HZ;
+		break;
+	case V4L2_CID_POWER_LINE_FREQUENCY_AUTO:
+		val = TEVS_FLICK_CTRL_MODE_AUTO |
+		      TEVS_FLICK_CTRL_FRC_OVERRIDE_UPPER_ET |
+		      TEVS_FLICK_CTRL_FRC_EN;
+		break;
+	default:
+		val = TEVS_FLICK_CTRL_MODE_DISABLED;
+		break;
+	}
+
+	return vlsgm2_i2c_write_16b(vlsgm2, TEVS_FLICK_CTRL, val);
+}
+
+static int vlsgm2_set_awb_temp(struct vlsgm2 *vlsgm2, s32 value)
+{
+	return vlsgm2_i2c_write_16b(vlsgm2, TEVS_AWB_MANUAL_TEMP,
+				  value & TEVS_AWB_MANUAL_TEMP_MASK);
+}
+
+static int vlsgm2_set_sharpen(struct vlsgm2 *vlsgm2, s32 value)
+{
+	// Format is u3.12
+	return vlsgm2_i2c_write_16b(vlsgm2, TEVS_SHARPEN,
+				  value & TEVS_SHARPEN_MASK);
+}
+
+static int vlsgm2_set_backlight_compensation(struct vlsgm2 *vlsgm2, s32 value)
+{
+	// Format is u3.12
+	return vlsgm2_i2c_write_16b(vlsgm2, TEVS_BACKLIGHT_COMPENSATION,
+				  value & TEVS_BACKLIGHT_COMPENSATION_MASK);
+}
+
+static int vlsgm2_set_special_effect(struct vlsgm2 *vlsgm2, s32 mode)
+{
+	u16 val = mode & TEVS_SFX_MODE_SFX_MASK;
+
+	switch (val) {
+	case TEVS_SFX_MODE_SFX_NORMAL_IDX:
+		val = TEVS_SFX_MODE_SFX_NORMAL;
+		break;
+	case TEVS_SFX_MODE_SFX_BW_IDX:
+		val = TEVS_SFX_MODE_SFX_BW;
+		break;
+	case TEVS_SFX_MODE_SFX_GRAYSCALE_IDX:
+		val = TEVS_SFX_MODE_SFX_GRAYSCALE;
+		break;
+	case TEVS_SFX_MODE_SFX_NEGATIVE_IDX:
+		val = TEVS_SFX_MODE_SFX_NEGATIVE;
+		break;
+	case TEVS_SFX_MODE_SFX_SKETCH_IDX:
+		val = TEVS_SFX_MODE_SFX_SKETCH;
+		break;
+	default:
+		val = TEVS_SFX_MODE_SFX_NORMAL;
+		break;
+	}
+
+	return vlsgm2_i2c_write_16b(vlsgm2, TEVS_SFX_MODE, val);
+}
+
+static int vlsgm2_set_ae_mode(struct vlsgm2 *vlsgm2, s32 mode)
+{
+	u16 val = mode & TEVS_AE_CTRL_MODE_MASK;
+	u8 exp[4] = { 0 };
+	int ret = 0;
+
+	switch (val) {
+	case TEVS_AE_CTRL_MANUAL_EXP_TIME_GAIN_IDX:
+		val = TEVS_AE_CTRL_MANUAL_EXP_TIME_GAIN;
+		break;
+	case TEVS_AE_CTRL_FULL_AUTO_IDX:
+		val = TEVS_AE_CTRL_FULL_AUTO;
+		break;
+	case TEVS_AE_CTRL_AUTO_GAIN_IDX:
+		val = TEVS_AE_CTRL_AUTO_GAIN;
+		break;
+	default:
+		val = TEVS_AE_CTRL_FULL_AUTO;
+		break;
+	}
+
+	ret += vlsgm2_i2c_write_16b(vlsgm2, TEVS_AE_CTRL_MODE, val);
+	ret += vlsgm2_i2c_read(vlsgm2, TEVS_AE_MANUAL_EXP_TIME, exp, 4);
+	vlsgm2->exp_time->cur.val = be32_to_cpup((__be32 *)exp) &
+				  TEVS_AE_MANUAL_EXP_TIME_MASK;
+	return ret;
+}
+
+static int vlsgm2_set_pan_target(struct vlsgm2 *vlsgm2, s32 value)
+{
+	// Format u7.8
+	return vlsgm2_i2c_write_16b(vlsgm2, TEVS_DZ_CT_X, value & TEVS_DZ_CT_MASK);
+}
+
+static int vlsgm2_set_tilt_target(struct vlsgm2 *vlsgm2, s32 value)
+{
+	// Format u7.8
+	return vlsgm2_i2c_write_16b(vlsgm2, TEVS_DZ_CT_Y, value & TEVS_DZ_CT_MASK);
+}
+
+static int vlsgm2_set_zoom_target(struct vlsgm2 *vlsgm2, s32 value)
+{
+	// Format u7.8
+	return vlsgm2_i2c_write_16b(vlsgm2, TEVS_DZ_TGT_FCT,
+				  value & TEVS_DZ_TGT_FCT_MASK);
+}
+
+static int vlsgm2_set_bsl_mode(struct vlsgm2 *vlsgm2, s32 mode)
+{
+	u16 val;
+	u8 bootcmd[6] = { 0x00, 0x12, 0x3A, 0x61, 0x44, 0xDE };
+	u8 startup[6] = { 0x00, 0x40, 0xE2, 0x51, 0x21, 0x5B };
+	u16 data_freq_tmp;
+	dev_dbg(vlsgm2->dev, "%s(): set bls mode: %d", __func__, mode);
+
+	switch (mode) {
+	case TEVS_BSL_MODE_NORMAL_IDX:
+		vlsgm2_i2c_write(vlsgm2, 0x8001, startup, 6);
+		vlsgm2_i2c_read(vlsgm2, 0x8001, (u8 *)&val, 1);
+
+		msleep(TEVS_BOOT_TIME);
+
+		if (vlsgm2_check_boot_state(vlsgm2) != 0) {
+			dev_err(vlsgm2->dev, "check tevs bootup status failed\n");
+			return -EINVAL;
+		}
+
+		if (vlsgm2->data_frequency != 0) {
+			vlsgm2_i2c_read_16b(vlsgm2, HOST_COMMAND_ISP_CTRL_MIPI_FREQ,
+					  &data_freq_tmp);
+			if (vlsgm2->data_frequency != data_freq_tmp) {
+				vlsgm2_i2c_write_16b(
+					vlsgm2, HOST_COMMAND_ISP_CTRL_MIPI_FREQ,
+					vlsgm2->data_frequency);
+				msleep(TEVS_BOOT_TIME);
+				if (vlsgm2_check_boot_state(vlsgm2) != 0) {
+					dev_err(vlsgm2->dev,
+						"check vlsgm2 bootup status failed\n");
+					return -EINVAL;
+				}
+			}
+		}
+
+		if (vlsgm2->trigger_mode) {
+			switch (vlsgm2->trigger_mode) {
+			case TEVS_TRIGGER_MODE_DISABLE_IDX:
+				val = TEVS_TRIGGER_MODE_DISABLE;
+				break;
+			case TEVS_TRIGGER_MODE_SYNC_IDX:
+				val = TEVS_TRIGGER_MODE_SYNC;
+				break;
+			case TEVS_TRIGGER_MODE_PERIODIC_IDX:
+				val = TEVS_TRIGGER_MODE_PERIODIC;
+				break;
+			case TEVS_TRIGGER_MODE_NON_PERIODIC_IDX:
+				val = TEVS_TRIGGER_MODE_NON_PERIODIC;
+				break;
+			default:
+				val = TEVS_TRIGGER_MODE_DISABLE;
+				break;
+			}
+			val |= 0x380;
+			if (vlsgm2_i2c_write_16b(vlsgm2, TEVS_TRIGGER_MODE, val) !=
+			    0) {
+				dev_err(vlsgm2->dev, "set trigger mode failed\n");
+				return -EINVAL;
+			}
+		}
+
+		vlsgm2_i2c_write_16b(vlsgm2, HOST_COMMAND_ISP_CTRL_PREVIEW_FORMAT,
+				   0x50);
+		vlsgm2_i2c_write_16b(vlsgm2,
+				   HOST_COMMAND_ISP_CTRL_PREVIEW_HINF_CTRL,
+				   0x10 | (vlsgm2->continuous_clock << 5) |
+					   (vlsgm2->data_lanes));
+		vlsgm2_i2c_write_16b(vlsgm2,
+				   HOST_COMMAND_ISP_CTRL_PREVIEW_MIPI_CTRL,
+				   vlsgm2->vc_id);
+
+		break;
+	case TEVS_BSL_MODE_FLASH_IDX:
+		vlsgm2_pca953x_reset(vlsgm2, 0);
+		usleep_range(9000, 10000);
+		vlsgm2_pca953x_standby(vlsgm2, 1);
+		msleep(100);
+		vlsgm2_pca953x_reset(vlsgm2, 1);
+		usleep_range(9000, 10000);
+		vlsgm2_pca953x_standby(vlsgm2, 0);
+		msleep(100);
+		vlsgm2_i2c_write(vlsgm2, 0x8001, bootcmd, 6);
+		vlsgm2_i2c_read(vlsgm2, 0x8001, (u8 *)&val, 1);
+		break;
+	default:
+		dev_err(vlsgm2->dev, "%s(): set err bls mode: %d", __func__,
+			mode);
+		break;
+	}
+
+	return 0;
+}
+
+static int vlsgm2_set_max_fps(struct vlsgm2 *vlsgm2, s32 value)
+{
+	u8 exp[4] = { 0 };
+	int ret = 0;
+	ret += vlsgm2_i2c_write_16b(vlsgm2, TEVS_MAX_FPS,
+				  value & TEVS_MAX_FPS_MASK);
+	ret += vlsgm2_i2c_read(vlsgm2, TEVS_AE_MANUAL_EXP_TIME, exp, 4);
+	vlsgm2->exp_time->cur.val = be32_to_cpup((__be32 *)exp) &
+				       TEVS_AE_MANUAL_EXP_TIME_MASK;
+	return ret;
+}
+
+static int vlsgm2_set_denoise(struct vlsgm2 *vlsgm2, s32 value)
+{
+	// Format is u3.12
+	return vlsgm2_i2c_write_16b(vlsgm2, TEVS_DENOISE,
+				  value & TEVS_DENOISE_MASK);
+}
+
+static int vlsgm2_set_ae_auto_exp_upper(struct vlsgm2 *vlsgm2, s32 value)
+{
+	u8 val[4];
+	__be32 temp;
+
+	temp = cpu_to_be32(value);
+	memcpy(val, &temp, 4);
+
+	return vlsgm2_i2c_write(vlsgm2, TEVS_AE_AUTO_EXP_TIME_UPPER, val, 4);
+}
+
+static int vlsgm2_set_ae_auto_exp_max(struct vlsgm2 *vlsgm2, s32 value)
+{
+	u8 val[4];
+	__be32 temp;
+
+	temp = cpu_to_be32(value);
+	memcpy(val, &temp, 4);
+
+	return vlsgm2_i2c_write(vlsgm2, TEVS_AE_AUTO_EXP_TIME_MAX, val, 4);
+}
+
+static int vlsgm2_set_trigger_mode(struct vlsgm2 *vlsgm2, s32 value)
+{
+	u16 val = value & TEVS_TRIGGER_MODE_MASK;
+
+	switch (val) {
+	case TEVS_TRIGGER_MODE_DISABLE_IDX:
+		val = TEVS_TRIGGER_MODE_DISABLE;
+		break;
+	case TEVS_TRIGGER_MODE_SYNC_IDX:
+		val = TEVS_TRIGGER_MODE_SYNC;
+		break;
+	case TEVS_TRIGGER_MODE_PERIODIC_IDX:
+		val = TEVS_TRIGGER_MODE_PERIODIC;
+		break;
+	case TEVS_TRIGGER_MODE_NON_PERIODIC_IDX:
+		val = TEVS_TRIGGER_MODE_NON_PERIODIC;
+		break;
+	default:
+		val = TEVS_TRIGGER_MODE_DISABLE;
+		break;
+	}
+
+	val |= 0x380;
+	return vlsgm2_i2c_write_16b(vlsgm2, TEVS_TRIGGER_MODE, val);
+}
+
+static int vlsgm2_s_ctrl(struct v4l2_ctrl *ctrl)
+{
+	struct vlsgm2 *vlsgm2 = container_of(ctrl->handler, struct vlsgm2, ctrls);
+
+	switch (ctrl->id) {
+	case V4L2_CID_BRIGHTNESS:
+		return vlsgm2_set_brightness(vlsgm2, ctrl->val);
+
+	case V4L2_CID_CONTRAST:
+		return vlsgm2_set_contrast(vlsgm2, ctrl->val);
+
+	case V4L2_CID_SATURATION:
+		return vlsgm2_set_saturation(vlsgm2, ctrl->val);
+
+	case V4L2_CID_AUTO_WHITE_BALANCE:
+		return vlsgm2_set_awb_mode(vlsgm2, ctrl->val);
+
+	case V4L2_CID_GAMMA:
+		return vlsgm2_set_gamma(vlsgm2, ctrl->val);
+
+	case V4L2_CID_EXPOSURE:
+		return vlsgm2_set_exposure(vlsgm2, ctrl->val);
+
+	case V4L2_CID_GAIN:
+		return vlsgm2_set_gain(vlsgm2, ctrl->val);
+
+	case V4L2_CID_HFLIP:
+		return vlsgm2_set_hflip(vlsgm2, ctrl->val);
+
+	case V4L2_CID_VFLIP:
+		return vlsgm2_set_vflip(vlsgm2, ctrl->val);
+
+	case V4L2_CID_POWER_LINE_FREQUENCY:
+		return vlsgm2_set_flick_mode(vlsgm2, ctrl->val);
+
+	case V4L2_CID_WHITE_BALANCE_TEMPERATURE:
+		return vlsgm2_set_awb_temp(vlsgm2, ctrl->val);
+
+	case V4L2_CID_SHARPNESS:
+		return vlsgm2_set_sharpen(vlsgm2, ctrl->val);
+
+	case V4L2_CID_BACKLIGHT_COMPENSATION:
+		return vlsgm2_set_backlight_compensation(vlsgm2, ctrl->val);
+
+	case V4L2_CID_COLORFX:
+		return vlsgm2_set_special_effect(vlsgm2, ctrl->val);
+
+	case V4L2_CID_EXPOSURE_AUTO:
+		return vlsgm2_set_ae_mode(vlsgm2, ctrl->val);
+
+	case V4L2_CID_PAN_ABSOLUTE:
+		return vlsgm2_set_pan_target(vlsgm2, ctrl->val);
+
+	case V4L2_CID_TILT_ABSOLUTE:
+		return vlsgm2_set_tilt_target(vlsgm2, ctrl->val);
+
+	case V4L2_CID_ZOOM_ABSOLUTE:
+		return vlsgm2_set_zoom_target(vlsgm2, ctrl->val);
+
+	case V4L2_CID_TEVS_BSL_MODE:
+		return vlsgm2_set_bsl_mode(vlsgm2, ctrl->val);
+
+	case V4L2_CID_TEVS_MAX_FPS:
+		return vlsgm2_set_max_fps(vlsgm2, ctrl->val);
+
+	case V4L2_CID_TEVS_DENOISE:
+		return vlsgm2_set_denoise(vlsgm2, ctrl->val);
+
+	case V4L2_CID_TEVS_AE_EXP_TIME_UPPER:
+		return vlsgm2_set_ae_auto_exp_upper(vlsgm2, ctrl->val);
+
+	case V4L2_CID_TEVS_AE_EXP_TIME_MAX:
+		return vlsgm2_set_ae_auto_exp_max(vlsgm2, ctrl->val);
+
+	case V4L2_CID_TEVS_TRIGGER_MODE:
+		return vlsgm2_set_trigger_mode(vlsgm2, ctrl->val);
+
+	default:
+		dev_dbg(vlsgm2->dev, "Unknown control 0x%x\n", ctrl->id);
+		return -EINVAL;
+	}
+}
+
+static const struct v4l2_ctrl_ops vlsgm2_ctrl_ops = {
+	.s_ctrl = vlsgm2_s_ctrl,
+};
+
+static const struct v4l2_ctrl_config vlsgm2_awb_mode = {
+	.ops = &vlsgm2_ctrl_ops,
+	.id = V4L2_CID_AUTO_WHITE_BALANCE,
+	.name = "White_Balance_Mode",
+	.type = V4L2_CTRL_TYPE_MENU,
+	.max = TEVS_AWB_CTRL_MODE_AUTO_IDX,
+	.def = TEVS_AWB_CTRL_MODE_AUTO_IDX,
+	.qmenu = awb_mode_strings,
+};
+
+static const struct v4l2_ctrl_config vlsgm2_sfx_mode = {
+	.ops = &vlsgm2_ctrl_ops,
+	.id = V4L2_CID_COLORFX,
+	.name = "Special_Effect",
+	.type = V4L2_CTRL_TYPE_MENU,
+	.max = TEVS_SFX_MODE_SFX_SKETCH_IDX,
+	.def = TEVS_SFX_MODE_SFX_NORMAL_IDX,
+	.qmenu = sfx_mode_strings,
+};
+
+static const struct v4l2_ctrl_config vlsgm2_ae_mode = {
+	.ops = &vlsgm2_ctrl_ops,
+	.id = V4L2_CID_EXPOSURE_AUTO,
+	.name = "Exposure_Mode",
+	.type = V4L2_CTRL_TYPE_MENU,
+	.max = TEVS_AE_CTRL_AUTO_GAIN_IDX,
+	.def = TEVS_AE_CTRL_FULL_AUTO_IDX,
+	.qmenu = ae_mode_strings,
+};
+
+static const struct v4l2_ctrl_config vlsgm2_bsl_mode = {
+	.ops = &vlsgm2_ctrl_ops,
+	.id = V4L2_CID_TEVS_BSL_MODE,
+	.name = "BSL_Mode",
+	.type = V4L2_CTRL_TYPE_MENU,
+	.max = TEVS_BSL_MODE_FLASH_IDX,
+	.def = TEVS_BSL_MODE_NORMAL_IDX,
+	.qmenu = bsl_mode_strings,
+};
+
+static const struct v4l2_ctrl_config vlsgm2_max_fps = {
+	.ops = &vlsgm2_ctrl_ops,
+	.id = V4L2_CID_TEVS_MAX_FPS,
+	.name = "Max_FPS",
+	.type = V4L2_CTRL_TYPE_INTEGER,
+	.min = 0x01,
+	.max = 0xFF,
+	.step = 1,
+	.def = 30,
+};
+
+static const struct v4l2_ctrl_config vlsgm2_denoise = {
+	.ops = &vlsgm2_ctrl_ops,
+	.id = V4L2_CID_TEVS_DENOISE,
+	.name = "Denoise",
+	.type = V4L2_CTRL_TYPE_INTEGER,
+	.min = 0x0000,
+	.max = 0x4000,
+	.step = 1,
+	.def = 0x2000,
+};
+
+static const struct v4l2_ctrl_config vlsgm2_ae_exp_upper = {
+	.ops = &vlsgm2_ctrl_ops,
+	.id = V4L2_CID_TEVS_AE_EXP_TIME_UPPER,
+	.name = "AE_Exposure_Upper",
+	.type = V4L2_CTRL_TYPE_INTEGER,
+	.min = 0x0000,
+	.max = 0xFFFFFFFFF,
+	.step = 1,
+	.def = 0x411A,
+};
+
+static const struct v4l2_ctrl_config vlsgm2_ae_exp_max = {
+	.ops = &vlsgm2_ctrl_ops,
+	.id = V4L2_CID_TEVS_AE_EXP_TIME_MAX,
+	.name = "AE_Exposure_Max",
+	.type = V4L2_CTRL_TYPE_INTEGER,
+	.min = 0x0000,
+	.max = 0xFFFFFFFFF,
+	.step = 1,
+	.def = 0x1046A,
+};
+
+static const struct v4l2_ctrl_config vlsgm2_trigger_mode = {
+	.ops = &vlsgm2_ctrl_ops,
+	.id = V4L2_CID_TEVS_TRIGGER_MODE,
+	.name = "Trigger_Mode",
+	.type = V4L2_CTRL_TYPE_MENU,
+	.max = TEVS_TRIGGER_MODE_NON_PERIODIC_IDX,
+	.def = TEVS_TRIGGER_MODE_DISABLE_IDX,
+	.qmenu = trigger_mode_strings,
+};
+
+static int vlsgm2_ctrls_init(struct vlsgm2 *vlsgm2)
+{
+	struct i2c_client *client = v4l2_get_subdevdata(&vlsgm2->v4l2_subdev);
+	struct v4l2_ctrl_handler *ctrl_hdlr;
+	struct v4l2_fwnode_device_properties props;
+	int ret;
+	u16 val;
+	s64 ctrl_def, ctrl_max, ctrl_min;
+	u8 exp[4] = { 0 };
+	// static s64 link_freq[] = {
+	// 	TEVS_LINK_FREQUENCY_DEFAULT,
+	// };
+	// static s64 pixel_rate[] = {
+	// 	TEVS_PIXEL_RATE_DEFAULT,
+	// };
+
+	ctrl_hdlr = &vlsgm2->ctrls;
+	ret = v4l2_ctrl_handler_init(ctrl_hdlr, 26);
+	if (ret)
+		return ret;
+
+	ctrl_hdlr->lock = &vlsgm2->lock;
+
+	ret = vlsgm2_i2c_read_16b(vlsgm2, TEVS_BRIGHTNESS, &val);
+	ctrl_def = val & TEVS_BRIGHTNESS_MASK;
+	ret += vlsgm2_i2c_read_16b(vlsgm2, TEVS_BRIGHTNESS_MAX, &val);
+	ctrl_max = val & TEVS_BRIGHTNESS_MASK;
+	ret += vlsgm2_i2c_read_16b(vlsgm2, TEVS_BRIGHTNESS_MIN, &val);
+	ctrl_min = val & TEVS_BRIGHTNESS_MASK;
+	if (ret)
+		goto error;
+	vlsgm2->brightness = v4l2_ctrl_new_std(ctrl_hdlr, &vlsgm2_ctrl_ops,
+					     V4L2_CID_BRIGHTNESS, ctrl_min,
+					     ctrl_max, 1, ctrl_def);
+
+	ret = vlsgm2_i2c_read_16b(vlsgm2, TEVS_CONTRAST, &val);
+	ctrl_def = val & TEVS_CONTRAST_MASK;
+	ret += vlsgm2_i2c_read_16b(vlsgm2, TEVS_CONTRAST_MAX, &val);
+	ctrl_max = val & TEVS_CONTRAST_MASK;
+	ret += vlsgm2_i2c_read_16b(vlsgm2, TEVS_CONTRAST_MIN, &val);
+	ctrl_min = val & TEVS_CONTRAST_MASK;
+	if (ret)
+		goto error;
+	vlsgm2->contrast = v4l2_ctrl_new_std(ctrl_hdlr, &vlsgm2_ctrl_ops,
+					   V4L2_CID_CONTRAST, ctrl_min,
+					   ctrl_max, 1, ctrl_def);
+
+	ret = vlsgm2_i2c_read_16b(vlsgm2, TEVS_SATURATION, &val);
+	ctrl_def = val & TEVS_SATURATION_MASK;
+	ret += vlsgm2_i2c_read_16b(vlsgm2, TEVS_SATURATION_MAX, &val);
+	ctrl_max = val & TEVS_SATURATION_MASK;
+	ret += vlsgm2_i2c_read_16b(vlsgm2, TEVS_SATURATION_MIN, &val);
+	ctrl_min = val & TEVS_SATURATION_MASK;
+	if (ret)
+		goto error;
+	vlsgm2->saturation = v4l2_ctrl_new_std(ctrl_hdlr, &vlsgm2_ctrl_ops,
+					     V4L2_CID_SATURATION, ctrl_min,
+					     ctrl_max, 1, ctrl_def);
+
+	vlsgm2->awb = v4l2_ctrl_new_custom(ctrl_hdlr, &vlsgm2_awb_mode, NULL);
+	ret = vlsgm2_i2c_read_16b(vlsgm2, TEVS_AWB_CTRL_MODE, &val);
+	if (ret)
+		goto error;
+	switch (val & TEVS_AWB_CTRL_MODE_MASK) {
+	case TEVS_AWB_CTRL_MODE_MANUAL_TEMP:
+		vlsgm2->awb->default_value = vlsgm2->awb->cur.val =
+			TEVS_AWB_CTRL_MODE_MANUAL_TEMP_IDX;
+		break;
+	case TEVS_AWB_CTRL_MODE_AUTO:
+		vlsgm2->awb->default_value = vlsgm2->awb->cur.val =
+			TEVS_AWB_CTRL_MODE_AUTO_IDX;
+		break;
+	default:
+		vlsgm2->awb->default_value = vlsgm2->awb->cur.val =
+			TEVS_AWB_CTRL_MODE_AUTO_IDX;
+		break;
+	}
+
+	ret = vlsgm2_i2c_read_16b(vlsgm2, TEVS_GAMMA, &val);
+	ctrl_def = val & TEVS_GAMMA_MASK;
+	ret += vlsgm2_i2c_read_16b(vlsgm2, TEVS_GAMMA_MAX, &val);
+	ctrl_max = val & TEVS_GAMMA_MASK;
+	ret += vlsgm2_i2c_read_16b(vlsgm2, TEVS_GAMMA_MIN, &val);
+	ctrl_min = val & TEVS_GAMMA_MASK;
+	if (ret)
+		goto error;
+	vlsgm2->gamma = v4l2_ctrl_new_std(ctrl_hdlr, &vlsgm2_ctrl_ops,
+					V4L2_CID_GAMMA, ctrl_min, ctrl_max, 1,
+					ctrl_def);
+
+	ret = vlsgm2_i2c_read(vlsgm2, TEVS_AE_MANUAL_EXP_TIME, exp, 4);
+	ctrl_def = be32_to_cpup((__be32 *)exp) & TEVS_AE_MANUAL_EXP_TIME_MASK;
+	ret += vlsgm2_i2c_read(vlsgm2, TEVS_AE_MANUAL_EXP_TIME_MAX, exp, 4);
+	ctrl_max = be32_to_cpup((__be32 *)exp) & TEVS_AE_MANUAL_EXP_TIME_MASK;
+	ret += vlsgm2_i2c_read(vlsgm2, TEVS_AE_MANUAL_EXP_TIME_MIN, exp, 4);
+	ctrl_min = be32_to_cpup((__be32 *)exp) & TEVS_AE_MANUAL_EXP_TIME_MASK;
+	if (ret)
+		goto error;
+	vlsgm2->exp_time = v4l2_ctrl_new_std(ctrl_hdlr, &vlsgm2_ctrl_ops,
+					   V4L2_CID_EXPOSURE, ctrl_min,
+					   ctrl_max, 1, ctrl_def);
+
+	ret = vlsgm2_i2c_read_16b(vlsgm2, TEVS_AE_MANUAL_GAIN, &val);
+	ctrl_def = val & TEVS_AE_MANUAL_GAIN_MASK;
+	ret += vlsgm2_i2c_read_16b(vlsgm2, TEVS_AE_MANUAL_GAIN_MAX, &val);
+	ctrl_max = val & TEVS_AE_MANUAL_GAIN_MASK;
+	ret += vlsgm2_i2c_read_16b(vlsgm2, TEVS_AE_MANUAL_GAIN_MIN, &val);
+	ctrl_min = val & TEVS_AE_MANUAL_GAIN_MASK;
+	if (ret)
+		goto error;
+	vlsgm2->exp_gain = v4l2_ctrl_new_std(ctrl_hdlr, &vlsgm2_ctrl_ops,
+					   V4L2_CID_GAIN, ctrl_min, ctrl_max, 1,
+					   ctrl_def);
+
+	ret = vlsgm2_i2c_read_16b(vlsgm2, TEVS_ORIENTATION, &val);
+	ctrl_def = val & TEVS_ORIENTATION_HFLIP;
+	if (ret)
+		goto error;
+	vlsgm2->hflip = v4l2_ctrl_new_std(ctrl_hdlr, &vlsgm2_ctrl_ops,
+					V4L2_CID_HFLIP, 0x0, 0x1, 1, ctrl_def);
+
+	ctrl_def = (val & TEVS_ORIENTATION_VFLIP) >> TEVS_ORIENTATION_VFLIP_BIT;
+	vlsgm2->vflip = v4l2_ctrl_new_std(ctrl_hdlr, &vlsgm2_ctrl_ops,
+					V4L2_CID_VFLIP, 0x0, 0x1, 1, ctrl_def);
+
+	ret = vlsgm2_i2c_read_16b(vlsgm2, TEVS_FLICK_CTRL, &val);
+	if (ret)
+		goto error;
+	switch (val & TEVS_FLICK_CTRL_MODE_MASK) {
+	case TEVS_FLICK_CTRL_MODE_DISABLED:
+		ctrl_def = V4L2_CID_POWER_LINE_FREQUENCY_DISABLED;
+		break;
+	case TEVS_FLICK_CTRL_MODE_MANUAL:
+		if ((val & TEVS_FLICK_CTRL_FREQ_MASK) ==
+		    TEVS_FLICK_CTRL_FREQ(50))
+			ctrl_def = V4L2_CID_POWER_LINE_FREQUENCY_50HZ;
+		else if ((val & TEVS_FLICK_CTRL_FREQ_MASK) ==
+			 TEVS_FLICK_CTRL_FREQ(60))
+			ctrl_def = V4L2_CID_POWER_LINE_FREQUENCY_60HZ;
+		break;
+	case TEVS_FLICK_CTRL_MODE_AUTO:
+		ctrl_def = V4L2_CID_POWER_LINE_FREQUENCY_AUTO;
+		break;
+	default:
+		ctrl_def = V4L2_CID_POWER_LINE_FREQUENCY_DISABLED;
+		break;
+	}
+	vlsgm2->flick = v4l2_ctrl_new_std_menu(ctrl_hdlr, &vlsgm2_ctrl_ops,
+					     V4L2_CID_POWER_LINE_FREQUENCY,
+					     V4L2_CID_POWER_LINE_FREQUENCY_AUTO,
+					     0, ctrl_def);
+
+	ret = vlsgm2_i2c_read_16b(vlsgm2, TEVS_AWB_MANUAL_TEMP, &val);
+	ctrl_def = val & TEVS_AWB_MANUAL_TEMP_MASK;
+	ret += vlsgm2_i2c_read_16b(vlsgm2, TEVS_AWB_MANUAL_TEMP_MAX, &val);
+	ctrl_max = val & TEVS_AWB_MANUAL_TEMP_MASK;
+	ret += vlsgm2_i2c_read_16b(vlsgm2, TEVS_AWB_MANUAL_TEMP_MIN, &val);
+	ctrl_min = val & TEVS_AWB_MANUAL_TEMP_MASK;
+	if (ret)
+		goto error;
+	vlsgm2->wb_temp = v4l2_ctrl_new_std(ctrl_hdlr, &vlsgm2_ctrl_ops,
+					  V4L2_CID_WHITE_BALANCE_TEMPERATURE,
+					  ctrl_min, ctrl_max, 1, ctrl_def);
+
+	ret = vlsgm2_i2c_read_16b(vlsgm2, TEVS_SHARPEN, &val);
+	ctrl_def = val & TEVS_SHARPEN_MASK;
+	ret += vlsgm2_i2c_read_16b(vlsgm2, TEVS_SHARPEN_MAX, &val);
+	ctrl_max = val & TEVS_SHARPEN_MASK;
+	ret += vlsgm2_i2c_read_16b(vlsgm2, TEVS_SHARPEN_MIN, &val);
+	ctrl_min = val & TEVS_SHARPEN_MASK;
+	if (ret)
+		goto error;
+	vlsgm2->sharpness = v4l2_ctrl_new_std(ctrl_hdlr, &vlsgm2_ctrl_ops,
+					    V4L2_CID_SHARPNESS, ctrl_min,
+					    ctrl_max, 1, ctrl_def);
+
+	ret = vlsgm2_i2c_read_16b(vlsgm2, TEVS_BACKLIGHT_COMPENSATION, &val);
+	ctrl_def = val & TEVS_BACKLIGHT_COMPENSATION_MASK;
+	ret += vlsgm2_i2c_read_16b(vlsgm2, TEVS_BACKLIGHT_COMPENSATION_MAX, &val);
+	ctrl_max = val & TEVS_BACKLIGHT_COMPENSATION_MASK;
+	ret += vlsgm2_i2c_read_16b(vlsgm2, TEVS_BACKLIGHT_COMPENSATION_MIN, &val);
+	ctrl_min = val & TEVS_BACKLIGHT_COMPENSATION_MASK;
+	if (ret)
+		goto error;
+	vlsgm2->backlight_comp = v4l2_ctrl_new_std(
+		ctrl_hdlr, &vlsgm2_ctrl_ops, V4L2_CID_BACKLIGHT_COMPENSATION,
+		ctrl_min, ctrl_max, 1, ctrl_def);
+
+	vlsgm2->colorfx = v4l2_ctrl_new_custom(ctrl_hdlr, &vlsgm2_sfx_mode, NULL);
+	ret = vlsgm2_i2c_read_16b(vlsgm2, TEVS_SFX_MODE, &val);
+	if (ret)
+		goto error;
+	switch (val & TEVS_SFX_MODE_SFX_MASK) {
+	case TEVS_SFX_MODE_SFX_NORMAL:
+		vlsgm2->colorfx->default_value = vlsgm2->colorfx->cur.val =
+			TEVS_SFX_MODE_SFX_NORMAL_IDX;
+		break;
+	case TEVS_SFX_MODE_SFX_BW:
+		vlsgm2->colorfx->default_value = vlsgm2->colorfx->cur.val =
+			TEVS_SFX_MODE_SFX_BW_IDX;
+		break;
+	case TEVS_SFX_MODE_SFX_GRAYSCALE:
+		vlsgm2->colorfx->default_value = vlsgm2->colorfx->cur.val =
+			TEVS_SFX_MODE_SFX_GRAYSCALE_IDX;
+		break;
+	case TEVS_SFX_MODE_SFX_NEGATIVE:
+		vlsgm2->colorfx->default_value = vlsgm2->colorfx->cur.val =
+			TEVS_SFX_MODE_SFX_NEGATIVE_IDX;
+		break;
+	case TEVS_SFX_MODE_SFX_SKETCH:
+		vlsgm2->colorfx->default_value = vlsgm2->colorfx->cur.val =
+			TEVS_SFX_MODE_SFX_SKETCH_IDX;
+		break;
+	default:
+		vlsgm2->colorfx->default_value = vlsgm2->colorfx->cur.val =
+			TEVS_SFX_MODE_SFX_NORMAL_IDX;
+		break;
+	}
+
+	vlsgm2->ae = v4l2_ctrl_new_custom(ctrl_hdlr, &vlsgm2_ae_mode, NULL);
+	ret = vlsgm2_i2c_read_16b(vlsgm2, TEVS_AE_CTRL_MODE, &val);
+	if (ret)
+		goto error;
+	switch (val & TEVS_AE_CTRL_MODE_MASK) {
+	case TEVS_AE_CTRL_MANUAL_EXP_TIME_GAIN:
+		vlsgm2->ae->default_value = vlsgm2->ae->cur.val =
+			TEVS_AE_CTRL_MANUAL_EXP_TIME_GAIN_IDX;
+		break;
+	case TEVS_AE_CTRL_FULL_AUTO:
+		vlsgm2->ae->default_value = vlsgm2->ae->cur.val =
+			TEVS_AE_CTRL_FULL_AUTO_IDX;
+		break;
+	case TEVS_AE_CTRL_AUTO_GAIN: {
+		u8 exp[4] = { 0 };
+		ret += vlsgm2_i2c_read(vlsgm2, TEVS_AE_MANUAL_EXP_TIME, exp, 4);
+		vlsgm2->exp_time->cur.val = be32_to_cpup((__be32 *)exp) &
+					  TEVS_AE_MANUAL_EXP_TIME_MASK;
+		vlsgm2->ae->default_value = vlsgm2->ae->cur.val =
+			TEVS_AE_CTRL_AUTO_GAIN_IDX;
+	} break;
+	default:
+		vlsgm2->ae->default_value = vlsgm2->ae->cur.val =
+			TEVS_AE_CTRL_FULL_AUTO_IDX;
+		break;
+	}
+
+	ret = vlsgm2_i2c_read_16b(vlsgm2, TEVS_DZ_CT_X, &val);
+	ctrl_def = val & TEVS_DZ_CT_MASK;
+	ret += vlsgm2_i2c_read_16b(vlsgm2, TEVS_DZ_CT_MAX, &val);
+	ctrl_max = val & TEVS_DZ_CT_MASK;
+	ret += vlsgm2_i2c_read_16b(vlsgm2, TEVS_DZ_CT_MIN, &val);
+	ctrl_min = val & TEVS_DZ_CT_MASK;
+	if (ret)
+		goto error;
+	vlsgm2->pan = v4l2_ctrl_new_std(ctrl_hdlr, &vlsgm2_ctrl_ops,
+				      V4L2_CID_PAN_ABSOLUTE, ctrl_min, ctrl_max,
+				      1, ctrl_def);
+
+	ret = vlsgm2_i2c_read_16b(vlsgm2, TEVS_DZ_CT_Y, &val);
+	ctrl_def = val & TEVS_DZ_CT_MASK;
+	ret += vlsgm2_i2c_read_16b(vlsgm2, TEVS_DZ_CT_MAX, &val);
+	ctrl_max = val & TEVS_DZ_CT_MASK;
+	ret += vlsgm2_i2c_read_16b(vlsgm2, TEVS_DZ_CT_MIN, &val);
+	ctrl_min = val & TEVS_DZ_CT_MASK;
+	if (ret)
+		goto error;
+	vlsgm2->tilt = v4l2_ctrl_new_std(ctrl_hdlr, &vlsgm2_ctrl_ops,
+				       V4L2_CID_TILT_ABSOLUTE, ctrl_min,
+				       ctrl_max, 1, ctrl_def);
+
+	ret = vlsgm2_i2c_read_16b(vlsgm2, TEVS_DZ_TGT_FCT, &val);
+	ctrl_def = val & TEVS_DZ_TGT_FCT_MASK;
+	ret += vlsgm2_i2c_read_16b(vlsgm2, TEVS_DZ_TGT_FCT_MAX, &val);
+	ctrl_max = val & TEVS_DZ_TGT_FCT_MASK;
+	ret += vlsgm2_i2c_read_16b(vlsgm2, TEVS_DZ_TGT_FCT_MIN, &val);
+	ctrl_min = val & TEVS_DZ_TGT_FCT_MASK;
+	if (ret)
+		goto error;
+	vlsgm2->zoom = v4l2_ctrl_new_std(ctrl_hdlr, &vlsgm2_ctrl_ops,
+				       V4L2_CID_ZOOM_ABSOLUTE, ctrl_min,
+				       ctrl_max, 1, ctrl_def);
+
+	/* By default, link_freq and pixel_rate is read only */
+	vlsgm2->link_freq = v4l2_ctrl_new_int_menu(
+		ctrl_hdlr, &vlsgm2_ctrl_ops, V4L2_CID_LINK_FREQ,
+		ARRAY_SIZE(vlsgm2_link_freqs) - 1, 0, vlsgm2_link_freqs);
+	vlsgm2->link_freq->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+
+	vlsgm2->pixel_rate =
+		v4l2_ctrl_new_std(ctrl_hdlr, &vlsgm2_ctrl_ops,
+				  V4L2_CID_PIXEL_RATE, vlsgm2_pixel_rates[0],
+				  vlsgm2_pixel_rates[0], 1, vlsgm2_pixel_rates[0]);
+	vlsgm2->pixel_rate->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+
+	vlsgm2->bsl = v4l2_ctrl_new_custom(ctrl_hdlr, &vlsgm2_bsl_mode, NULL);
+
+	vlsgm2->max_fps = v4l2_ctrl_new_custom(ctrl_hdlr, &vlsgm2_max_fps, NULL);
+	ret = vlsgm2_i2c_read_16b(vlsgm2, TEVS_MAX_FPS, &val);
+	if (ret)
+		goto error;
+	vlsgm2->max_fps->default_value = vlsgm2->max_fps->cur.val =
+		val & TEVS_MAX_FPS_MASK;
+
+	vlsgm2->denoise = v4l2_ctrl_new_custom(ctrl_hdlr, &vlsgm2_denoise, NULL);
+	ret = vlsgm2_i2c_read_16b(vlsgm2, TEVS_DENOISE, &val);
+	ctrl_def = val & TEVS_DENOISE_MASK;
+	ret += vlsgm2_i2c_read_16b(vlsgm2, TEVS_DENOISE_MAX, &val);
+	ctrl_max = val & TEVS_DENOISE_MASK;
+	ret += vlsgm2_i2c_read_16b(vlsgm2, TEVS_DENOISE_MIN, &val);
+	ctrl_min = val & TEVS_DENOISE_MASK;
+	if (ret)
+		goto error;
+	vlsgm2->denoise->default_value = vlsgm2->denoise->cur.val = ctrl_def;
+	vlsgm2->denoise->maximum = ctrl_max;
+	vlsgm2->denoise->minimum = ctrl_min;
+
+	vlsgm2->ae_exp_upper =
+		v4l2_ctrl_new_custom(ctrl_hdlr, &vlsgm2_ae_exp_upper, NULL);
+	ret = vlsgm2_i2c_read(vlsgm2, TEVS_AE_AUTO_EXP_TIME_UPPER, exp, 4);
+	ctrl_def = be32_to_cpup((__be32 *)exp) & TEVS_AE_AUTO_EXP_TIME_MASK;
+	ret += vlsgm2_i2c_read(vlsgm2, TEVS_AE_MANUAL_EXP_TIME_MAX, exp, 4);
+	ctrl_max = be32_to_cpup((__be32 *)exp) & TEVS_AE_MANUAL_EXP_TIME_MASK;
+	ret += vlsgm2_i2c_read(vlsgm2, TEVS_AE_MANUAL_EXP_TIME_MIN, exp, 4);
+	ctrl_min = be32_to_cpup((__be32 *)exp) & TEVS_AE_MANUAL_EXP_TIME_MASK;
+	if (ret)
+		goto error;
+	vlsgm2->ae_exp_upper->default_value = vlsgm2->ae_exp_upper->cur.val =
+		ctrl_def;
+	vlsgm2->ae_exp_upper->maximum = ctrl_max;
+	vlsgm2->ae_exp_upper->minimum = ctrl_min;
+
+	vlsgm2->ae_exp_max =
+		v4l2_ctrl_new_custom(ctrl_hdlr, &vlsgm2_ae_exp_max, NULL);
+	ret = vlsgm2_i2c_read(vlsgm2, TEVS_AE_AUTO_EXP_TIME_MAX, exp, 4);
+	ctrl_def = be32_to_cpup((__be32 *)exp) & TEVS_AE_AUTO_EXP_TIME_MASK;
+	if (ret)
+		goto error;
+	vlsgm2->ae_exp_max->default_value = vlsgm2->ae_exp_max->cur.val = ctrl_def;
+	vlsgm2->ae_exp_max->maximum = ctrl_max;
+	vlsgm2->ae_exp_max->minimum = ctrl_min;
+
+	vlsgm2->trigger =
+		v4l2_ctrl_new_custom(ctrl_hdlr, &vlsgm2_trigger_mode, NULL);
+	vlsgm2->trigger->default_value = vlsgm2->trigger->cur.val =
+		vlsgm2->trigger_mode;
+
+	if (ctrl_hdlr->error) {
+		ret = ctrl_hdlr->error;
+		dev_err(vlsgm2->dev, "ctrls init error (%d)\n", ret);
+		goto error;
+	}
+
+	ret = v4l2_fwnode_device_parse(&client->dev, &props);
+	if (ret)
+		goto error;
+
+	ret = v4l2_ctrl_new_fwnode_properties(ctrl_hdlr, &vlsgm2_ctrl_ops,
+					      &props);
+	if (ret)
+		goto error;
+
+	vlsgm2->v4l2_subdev.ctrl_handler = ctrl_hdlr;
+
+	return 0;
+
+error:
+	v4l2_ctrl_handler_free(ctrl_hdlr);
+	mutex_destroy(&vlsgm2->lock);
+
+	return ret;
+}
+
+static void vlsgm2_ctrls_free(struct vlsgm2 *vlsgm2)
+{
+	v4l2_ctrl_handler_free(&vlsgm2->ctrls);
+	mutex_destroy(&vlsgm2->lock);
+}
+
+static int vlsgm2_media_link_setup(struct media_entity *entity,
+				 const struct media_pad *local,
+				 const struct media_pad *remote, u32 flags)
+{
+	return 0;
+}
+
+static int vlsgm2_power_on(struct vlsgm2 *vlsgm2)
+{
+	int ret = 0;
+	dev_dbg(vlsgm2->dev, "%s()\n", __func__);
+
+	vlsgm2_pca953x_reset(vlsgm2, 1);
+
+	msleep(TEVS_BOOT_TIME);
+
+	ret = vlsgm2_check_boot_state(vlsgm2);
+	if (ret != 0) {
+		goto error;
+	}
+
+	if (vlsgm2->trigger_mode | vlsgm2->hw_reset_mode) {
+		ret = vlsgm2_set_trigger_mode(vlsgm2, vlsgm2->trigger_mode);
+		if (ret != 0) {
+			dev_err(vlsgm2->dev, "set trigger mode failed\n");
+			return ret;
+		}
+
+		ret += vlsgm2_i2c_write_16b(
+			vlsgm2, HOST_COMMAND_ISP_CTRL_PREVIEW_FORMAT, 0x50);
+		ret += vlsgm2_i2c_write_16b(
+			vlsgm2, HOST_COMMAND_ISP_CTRL_PREVIEW_HINF_CTRL,
+			0x10 | (vlsgm2->continuous_clock << 5) |
+				(vlsgm2->data_lanes));
+		ret += vlsgm2_i2c_write_16b(
+			vlsgm2, HOST_COMMAND_ISP_CTRL_PREVIEW_MIPI_CTRL,
+			vlsgm2->vc_id);
+	}
+
+	return ret;
+
+error:
+	vlsgm2_pca953x_reset(vlsgm2, 0);
+
+	return ret;
+}
+
+static int vlsgm2_power_off(struct vlsgm2 *vlsgm2)
+{
+	dev_dbg(vlsgm2->dev, "%s()\n", __func__);
+
+	if (vlsgm2->hw_reset_mode)
+		gpiod_set_value_cansleep(vlsgm2->reset_gpio, 0);
+
+	return 0;
+}
+
+static int vlsgm2_power(struct v4l2_subdev *sub_dev, int on)
+{
+	struct vlsgm2 *vlsgm2 = container_of(sub_dev, struct vlsgm2, v4l2_subdev);
+	dev_dbg(sub_dev->dev, "%s() [%d]\n", __func__, on);
+	if (on)
+		return vlsgm2_power_on(vlsgm2);
+	else
+		return vlsgm2_power_off(vlsgm2);
+}
+
+static int vlsgm2_open(struct v4l2_subdev *sub_dev, struct v4l2_subdev_fh *fh)
+{
+	struct vlsgm2 *vlsgm2 = container_of(sub_dev, struct vlsgm2, v4l2_subdev);
+	dev_info(vlsgm2->dev, "%s()\n", __func__);
+	return 0;
+}
+
+static const struct v4l2_subdev_internal_ops vlsgm2_internal_ops = {
+	.open = vlsgm2_open,
+};
+
+static const struct v4l2_subdev_core_ops vlsgm2_v4l2_subdev_core_ops = {
+	.s_power = vlsgm2_power,
+	.subscribe_event = v4l2_ctrl_subdev_subscribe_event,
+	.unsubscribe_event = v4l2_event_subdev_unsubscribe,
+};
+
+static const struct v4l2_subdev_video_ops vlsgm2_v4l2_subdev_video_ops = {
+	.s_stream = vlsgm2_set_stream,
+};
+
+static const struct v4l2_subdev_pad_ops vlsgm2_subdev_pad_ops = {
+	.enum_mbus_code = vlsgm2_enum_mbus_code,
+	.get_fmt = vlsgm2_get_fmt,
+	.set_fmt = vlsgm2_set_fmt,
+	.get_frame_desc = vlsgm2_get_frame_desc,
+	.get_selection = vlsgm2_get_selection,
+	.enum_frame_size = vlsgm2_enum_frame_size,
+	.enum_frame_interval = vlsgm2_enum_frame_interval,
+};
+
+static const struct v4l2_subdev_ops vlsgm2_subdev_ops = {
+	.core = &vlsgm2_v4l2_subdev_core_ops,
+	.video = &vlsgm2_v4l2_subdev_video_ops,
+	.pad = &vlsgm2_subdev_pad_ops,
+};
+
+static const struct media_entity_operations vlsgm2_media_entity_ops = {
+	.link_setup = vlsgm2_media_link_setup,
+	.link_validate = v4l2_subdev_link_validate
+};
+
+static int vlsgm2_try_on(struct vlsgm2 *vlsgm2)
+{
+	vlsgm2_power_off(vlsgm2);
+	return vlsgm2_power_on(vlsgm2);
+}
+
+static int vlsgm2_probe(struct i2c_client *client)
+{
+	struct vlsgm2 *vlsgm2 = NULL;
+	struct device *dev = &client->dev;
+	struct v4l2_mbus_framefmt *fmt;
+	int i = ARRAY_SIZE(tevs_sensor_table);
+	int ret;
+
+	dev_info(dev, "Probing VLS-GM2: addr=0x%02x", client->addr);
+
+	vlsgm2 = devm_kzalloc(dev, sizeof(struct vlsgm2), GFP_KERNEL);
+	if (vlsgm2 == NULL) {
+		dev_err(dev, "vlsgm2 allocate memory failed\n");
+		return -ENOMEM;
+	}
+
+	vlsgm2->platform_data = client->dev.platform_data;
+	if (vlsgm2->platform_data == NULL)
+		dev_warn(&client->dev, "no platform data provided\n");
+
+	vlsgm2->dev = &client->dev;
+
+	ret = vlsgm2_rpi22_trick_init(vlsgm2);
+	if (ret != 0) {
+		dev_err(dev, "tevs rpi22 trick control failed\n");
+		return -EINVAL;
+	}
+
+	msleep(50);
+
+	v4l2_i2c_subdev_init(&vlsgm2->v4l2_subdev, client, &vlsgm2_subdev_ops);
+
+	if (vlsgm2->platform_data && vlsgm2->platform_data->suffix)
+		snprintf(vlsgm2->v4l2_subdev.name,
+				sizeof(vlsgm2->v4l2_subdev.name), "vlsgm2 %c",
+				vlsgm2->platform_data->suffix);
+
+	vlsgm2_pca953x_reset(vlsgm2, 0);
+	msleep(TEVS_BOOT_TIME);
+	vlsgm2_pca953x_reset(vlsgm2, 1);
+	msleep(TEVS_BOOT_TIME);
+
+	vlsgm2->regmap = devm_regmap_init_i2c(client, &vlsgm2_regmap_config);
+	if (IS_ERR(vlsgm2->regmap)) {
+		dev_err(dev, "Unable to initialize I2C\n");
+		return -ENODEV;
+	}
+
+	vlsgm2->data_lanes = 4;
+	vlsgm2->continuous_clock = vlsgm2_continuous_clk;
+	vlsgm2->data_frequency = vlsgm2_data_freq;
+	vlsgm2->trigger_mode = 0;
+	dev_dbg(dev,
+		"data-lanes [%d], data-frequency [%d], continuous-clock [%d],"
+		" hw-reset [%d], trigger-mode [%d]\n",
+		vlsgm2->data_lanes, vlsgm2->data_frequency, vlsgm2->continuous_clock,
+		vlsgm2->hw_reset_mode, vlsgm2->trigger_mode);
+
+	if (vlsgm2_try_on(vlsgm2) != 0) {
+		dev_err(dev, "cannot find tevs camera\n");
+		return -EINVAL;
+	}
+
+	if (vlsgm2->data_frequency != 0) {
+		ret = vlsgm2_i2c_write_16b(vlsgm2, HOST_COMMAND_ISP_CTRL_MIPI_FREQ,
+					 vlsgm2->data_frequency);
+		msleep(TEVS_BOOT_TIME);
+		if (vlsgm2_check_boot_state(vlsgm2) != 0) {
+			dev_err(vlsgm2->dev, "check tevs bootup status failed\n");
+			ret = -EINVAL;
+			goto error_power_off;
+		}
+		if (ret < 0) {
+			dev_err(vlsgm2->dev, "set mipi frequency failed\n");
+			ret = -EINVAL;
+			goto error_power_off;
+		}
+	}
+
+	ret = vlsgm2_check_version(vlsgm2);
+	if (ret < 0) {
+		dev_err(dev, "check device version failed\n");
+		ret = -EINVAL;
+		goto error_power_off;
+	}
+
+	vlsgm2->header_info =
+		devm_kzalloc(dev, sizeof(struct header_info), GFP_KERNEL);
+	if (vlsgm2->header_info == NULL) {
+		dev_err(dev, "allocate header_info failed\n");
+		ret = -ENOMEM;
+		goto error_power_off;
+	}
+
+	ret = vlsgm2_load_header_info(vlsgm2);
+	if (ret < 0) {
+		dev_err(dev, "load header information failed\n");
+		ret = -EINVAL;
+		goto error_power_off;
+	} else {
+		for (i = 0; i < ARRAY_SIZE(tevs_sensor_table); i++) {
+			if (strcmp((const char *)vlsgm2->header_info->product_name,
+				   tevs_sensor_table[i].sensor_name) == 0)
+				break;
+		}
+	}
+
+	if (i >= ARRAY_SIZE(tevs_sensor_table)) {
+		dev_err(dev, "cannot not support the product: %s\n",
+			(const char *)vlsgm2->header_info->product_name);
+		ret = -EINVAL;
+		goto error_power_off;
+	}
+
+	vlsgm2->selected_sensor = i;
+	dev_info(dev, "selected_sensor:%d, sensor_name:%s\n", i,
+		vlsgm2->header_info->product_name);
+
+	/* Initialize default format */
+	fmt = &vlsgm2->fmt;
+	fmt->width = tevs_sensor_table[vlsgm2->selected_sensor].res_list[0].width;
+	fmt->height =
+		tevs_sensor_table[vlsgm2->selected_sensor].res_list[0].height;
+	fmt->field = V4L2_FIELD_NONE;
+	fmt->code = MEDIA_BUS_FMT_UYVY8_1X16;
+	fmt->colorspace = V4L2_COLORSPACE_SRGB;
+	fmt->ycbcr_enc = V4L2_MAP_YCBCR_ENC_DEFAULT(fmt->colorspace);
+	fmt->quantization = V4L2_QUANTIZATION_FULL_RANGE;
+	fmt->xfer_func = V4L2_MAP_XFER_FUNC_DEFAULT(fmt->colorspace);
+	memset(fmt->reserved, 0, sizeof(fmt->reserved));
+
+	/* link_freq = (pixel_rate * bpp) / (2 * data_lanes) */
+	vlsgm2_link_freqs[0] =
+		(vlsgm2_pixel_rates[0] * 16) / (2 * vlsgm2->data_lanes);
+
+	ret = vlsgm2_ctrls_init(vlsgm2);
+	if (ret) {
+		dev_err(&client->dev, "failed to init controls: %d", ret);
+		goto error_power_off;
+	}
+
+	/* Initialize subdev */
+	vlsgm2->v4l2_subdev.internal_ops = &vlsgm2_internal_ops;
+	vlsgm2->v4l2_subdev.flags |=
+		(V4L2_SUBDEV_FL_HAS_EVENTS | V4L2_SUBDEV_FL_HAS_DEVNODE);
+	vlsgm2->v4l2_subdev.entity.ops = &vlsgm2_media_entity_ops;
+	vlsgm2->v4l2_subdev.entity.function = MEDIA_ENT_F_CAM_SENSOR;
+
+	/* Initialize source pads */
+	vlsgm2->pad.flags = MEDIA_PAD_FL_SOURCE;
+	ret = media_entity_pads_init(&vlsgm2->v4l2_subdev.entity, 1, &vlsgm2->pad);
+	if (ret) {
+		dev_err(vlsgm2->dev, "failed to init entity pads: %d\n", ret);
+		goto error_handler_free;
+	}
+
+	ret = v4l2_async_register_subdev(&vlsgm2->v4l2_subdev);
+	if (ret != 0) {
+		dev_err(vlsgm2->dev, "v4l2 register failed\n");
+		goto error_media_entity;
+	}
+
+	if (vlsgm2->trigger_mode) {
+		ret = vlsgm2_set_trigger_mode(vlsgm2, vlsgm2->trigger_mode);
+		if (ret != 0) {
+			dev_err(vlsgm2->dev, "set trigger mode failed\n");
+			goto error_media_entity;
+		}
+	}
+
+	if (!(vlsgm2->hw_reset_mode | vlsgm2->trigger_mode)) {
+		ret = vlsgm2_standby(vlsgm2, 1);
+		if (ret != 0) {
+			dev_err(vlsgm2->dev, "set standby mode failed\n");
+			goto error_media_entity;
+		}
+	} else
+		ret = vlsgm2_power_off(vlsgm2);
+	if (ret == 0)
+		dev_info(dev, "%s probe success\n", vlsgm2->v4l2_subdev.name);
+	else
+		dev_err(dev, "%s probe failed\n", vlsgm2->v4l2_subdev.name);
+
+    /*
+	 * Device is already turned on by i2c-core with ACPI domain PM.
+	 * Enable runtime PM and turn off the device.
+	 */
+	pm_runtime_set_active(dev);
+	pm_runtime_enable(dev);
+	pm_runtime_idle(dev);
+
+	return 0;
+
+error_media_entity:
+	media_entity_cleanup(&vlsgm2->v4l2_subdev.entity);
+
+error_handler_free:
+	vlsgm2_ctrls_free(vlsgm2);
+
+error_power_off:
+	vlsgm2_power_off(vlsgm2);
+	dev_err(dev, "%s Probe Failed", vlsgm2->v4l2_subdev.name);
+
+	return ret;
+}
+
+static void vlsgm2_remove(struct i2c_client *client)
+{
+	struct v4l2_subdev *sub_dev = i2c_get_clientdata(client);
+	struct vlsgm2 *vlsgm2 = container_of(sub_dev, struct vlsgm2, v4l2_subdev);
+
+	v4l2_async_unregister_subdev(sub_dev);
+	media_entity_cleanup(&sub_dev->entity);
+	vlsgm2_ctrls_free(vlsgm2);
+	pm_runtime_disable(&client->dev);
+}
+
+static const struct i2c_device_id sensor_id[] = { { DRIVER_NAME, 0 }, {} };
+MODULE_DEVICE_TABLE(i2c, sensor_id);
+
+static const struct of_device_id sensor_of[] = { { .compatible =
+							   "tn," DRIVER_NAME },
+						 { /* sentinel */ } };
+MODULE_DEVICE_TABLE(of, sensor_of);
+
+static struct i2c_driver sensor_i2c_driver = {
+	.driver = {
+		.of_match_table = of_match_ptr(sensor_of),
+		.name  = DRIVER_NAME,
+	},
+	.probe = vlsgm2_probe,
+	.remove = vlsgm2_remove,
+	.id_table = sensor_id,
+};
+
+module_i2c_driver(sensor_i2c_driver);
+
+MODULE_AUTHOR("TECHNEXION Inc.");
+MODULE_DESCRIPTION("TechNexion TEVS camera driver for Intel Platforms");
+MODULE_LICENSE("GPL");
+MODULE_VERSION("1.0");
+MODULE_ALIAS("Camera");
Index: linux-kernel-v6.17/drivers/media/platform/intel/ipu-acpi.c
===================================================================
