@@ -76,6 +76,8 @@ static const struct ipu_acpi_devices sup
 #if IS_ENABLED(CONFIG_VIDEO_TEVS)
 	{ "TN_TEVS", TEVS_NAME, get_sensor_pdata, NULL, 0, TYPE_DIRECT, NULL,
 		TEVS_I2C_ADDRESS, 400 },	// TEVS HID
+	{ "VLSGM296", "vlsgm2", get_sensor_pdata, NULL, 0, TYPE_SERDES, "max96724",
+		TEVS_I2C_ADDRESS, 1600 },
 #endif
 };
 
